{
  "name": "@sjon-lang/web",
  "version": "1.4.3",
  "type": "module",
  "description": "SJON validating host for Node and the browser: SjonHost, SjonEncoder, SjonReader over sjon.wasm + sjon-binary.wasm.",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HugoDaniel/SJON.git",
    "directory": "hosts/web"
  },
  "homepage": "https://hugodaniel.com/pages/sjon",
  "publishConfig": {
    "access": "public",
    "main": "./dist/sjon-reader.js",
    "types": "./dist/sjon-reader.d.ts",
    "exports": {
      ".": { "types": "./dist/sjon-reader.d.ts", "default": "./dist/sjon-reader.js" },
      "./SjonHost": { "types": "./dist/SjonHost.d.ts", "default": "./dist/SjonHost.js" },
      "./SjonSchemaBackend": {
        "types": "./dist/SjonSchemaBackend.d.ts",
        "default": "./dist/SjonSchemaBackend.js"
      },
      "./createNodeFsResolver": {
        "types": "./dist/createNodeFsResolver.d.ts",
        "default": "./dist/createNodeFsResolver.js"
      }
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types 'test/*.test.ts' '*.test.ts'",
    "demo": "node --experimental-strip-types demo.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:browser": "tsc -p tsconfig.browser.json",
    "prepack": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@sjon-lang/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "typescript": "^5.8.0"
  },
  "exports": {
    ".": "./sjon-reader.ts",
    "./SjonHost": "./SjonHost.ts",
    "./SjonSchemaBackend": "./SjonSchemaBackend.ts",
    "./createNodeFsResolver": "./createNodeFsResolver.ts"
  }
}
