{
  "name": "@sjon-lang/highlight",
  "version": "1.4.2",
  "type": "module",
  "description": "SJON syntax-highlighting grammars: a CodeMirror StreamLanguage and a Shiki-compatible TextMate grammar for .sjon sources.",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HugoDaniel/SJON.git",
    "directory": "hosts/highlight"
  },
  "homepage": "https://hugodaniel.com/pages/sjon",
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types 'test/*.test.ts'",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.10.6"
  },
  "devDependencies": {
    "@codemirror/language": "^6.10.6",
    "@types/node": "^22.0.0",
    "shiki": "^1.29.2",
    "typescript": "^5.8.0"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
