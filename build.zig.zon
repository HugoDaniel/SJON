.{
    .name = .sjon,
    .version = "1.4.3",
    .fingerprint = 0x55e1a5afcbd94641,
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
    },
    .dependencies = .{
        // Fetched by url, pinned to the upstream commit wgslender pins. A
        // path into a sibling checkout resolves on one machine only, and
        // the build runner opens every declared path before it looks at
        // the requested step, so a missing directory fails every
        // `zig build` command, `--help` included. A submodule would not
        // help: `git archive` drops submodule contents, and the release
        // snapshots are cut with it.
        //
        // The pin is unpatched upstream. `src/lsp/main.zig` carries the
        // comptime block that lets `basic_server` accept a handler this
        // size under the default branch quota.
        .lsp_kit = .{
            .url = "https://github.com/zigtools/lsp-kit/archive/ec325a3c33d1da7708cf513355208f74d9560580.tar.gz",
            .hash = "lsp_kit-0.1.0-bi_PL_kyDACVTEhLaMq2-PJx0MocqRyjXDAN0ybMUyQQ",
            .lazy = true,
        },
    },
}
