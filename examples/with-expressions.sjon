; SJON: every safe-expression operation, exercised once.
;
; Each top-level item is a bare safe expression. The file parses and
; validates cleanly under the built-in `core` schema, and every form
; evaluates to a deterministic value (no host bindings required).

; -- Arithmetic -------------------------------------------------------------

(+ 1 2 3)              ; 6
(- 10 3 2)             ; 5
(* 2 3 4)              ; 24
(/ 100 5 2)            ; 10
(mod 17 5)             ; 2

; -- Comparison -------------------------------------------------------------

(< 1 2)                ; true
(> 5 2)                ; true
(<= 3 3)               ; true
(>= 3 3)               ; true
(= 7 7)                ; true
(!= 1 2)               ; true

; -- Logical (short-circuit) ------------------------------------------------

(and true true 1)      ; 1, the last truthy value
(or false 0 nil 42)    ; 42, the first truthy value
(not false)            ; true

; -- Binding and control ----------------------------------------------------

(let [r 0.5]
  (vec3 r r r))        ; [0.5 0.5 0.5]

(if (> 5 2) "big" "small")   ; "big"

(cond (< 1 0) "negative"
      (= 1 0) "zero"
      true    "positive")    ; "positive"

; -- Vectors ----------------------------------------------------------------

(vec2 1 2)             ; [1 2]
(vec3 1 2 3)           ; [1 2 3]
(vec4 1 2 3 4)         ; [1 2 3 4]

; -- Math -------------------------------------------------------------------

(lerp 0 10 0.25)                   ; 2.5
(lerp :from 0 :to 10 :t 0.25)      ; 2.5, labeled call, same result
(lerp :t 0.25 :from 0 :to 10)      ; 2.5, labels work in any order
(clamp 1.5 0 1)                    ; 1
(clamp :x 1.5 :lo 0 :hi 1)         ; 1, labeled call
(min 3 1 4 1 5 9 2)    ; 1
(max 3 1 4 1 5 9 2)    ; 9
(dot (vec3 1 2 3) (vec3 4 5 6))         ; 32
(cross (vec3 1 0 0) (vec3 0 1 0))       ; [0 0 1]
(length (vec3 3 4 0))                   ; 5

; -- Math (extended) --------------------------------------------------------

(abs -3.5)             ; 3.5
(sign -2)              ; -1
(floor 1.7)            ; 1
(ceil 1.2)             ; 2
(round 0.5)            ; 1, half away from zero
(fract 1.25)           ; 0.25
(sqrt 9)               ; 3
(pow 2 8)              ; 256
(sin 0)                ; 0
(cos 0)                ; 1
(tan 0)                ; 0
(asin 0)               ; 0
(acos 1)               ; 0
(atan 0)               ; 0
(atan2 1 0)            ; π/2, positional `(y x)` order
(atan2 :y 1 :x 0)      ; π/2, labeled: the y/x confusion goes away
(atan2 :x 0 :y 1)      ; π/2, labels in any order
(radians 180)          ; π
(degrees (pi))         ; 180

; -- Constants --------------------------------------------------------------

(pi)                   ; 3.141592653589793
(tau)                  ; 6.283185307179586

; -- Smoothing (WGSL conventions) -------------------------------------------

(saturate 1.5)         ; 1
(saturate -0.5)        ; 0
(step 0.5 0.6)         ; 1
(step 0.5 0.4)         ; 0
(smoothstep 0 1 0.5)   ; 0.5

; -- Vector ops -------------------------------------------------------------

(normalize (vec3 3 0 0))                ; [1 0 0]
(distance (vec3 0 0 0) (vec3 3 4 0))    ; 5
(reflect (vec3 1 -1 0) (vec3 0 1 0))    ; [1 1 0]

; -- List ops ---------------------------------------------------------------

(nth [10 20 30] 1)     ; 20
(count [1 2 3 4 5])    ; 5

; -- Seeded random (deterministic SplitMix64) -------------------------------
;
; All randoms are pure functions of (seed, key, …). Same inputs → same
; outputs across platforms and Zig versions.

(hash 1 0)             ; deterministic 53-bit integer
(rand01 1 0)           ; deterministic float in [0, 1)
(rand-range 1 0 0 100) ; deterministic float in [0, 100)
(rand-int 1 0 0 9)     ; deterministic integer in [0, 9]
(rand-bool 1 0 0.5)    ; deterministic boolean
(rand-choice 1 0 [10 20 30])  ; deterministic pick
