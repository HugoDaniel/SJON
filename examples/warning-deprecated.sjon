; Inline-manifest fixture producing a WARNING-severity diagnostic
; (`deprecated_member`) — used by the CLI tests for `--format=github`
; annotation mapping (`::warning`) and any other warning-channel cases.
(plugin :name probe :version "1.0.0"
  (value-kind :name status
    :underlying symbol
    :members (member-set
      (member :name draft :label "Draft")
      (member :name archived :deprecated true)))
  (form :name post
    (key :name status :type status :optional false)))

(post :status archived)
