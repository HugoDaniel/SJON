{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-sjon-export-version": 1,
  "x-sjon-export-warnings": [
    {
      "code": "exclusive_group_unenforceable",
      "severity": "info",
      "message": "form `route` exclusive groups emitted structurally (`oneOf` for exactly_one, `not:{allOf}` for at_most_one); source-order constraints between variant keys and discriminants remain SJON-only",
      "plugin": "xkey",
      "form": "route"
    },
    {
      "code": "multi_key_exclusive_emitted",
      "severity": "info",
      "message": "form `route` has at least one multi-key bundle in an exclusive group; emitted as `{required: [<bundle>]}` per bundle. Bundle atomicity (partial bundles fail) requires SJON-aware runtime validation",
      "plugin": "xkey",
      "form": "route"
    },
    {
      "code": "exclusive_group_unenforceable",
      "severity": "info",
      "message": "form `tag` exclusive groups emitted structurally (`oneOf` for exactly_one, `not:{allOf}` for at_most_one); source-order constraints between variant keys and discriminants remain SJON-only",
      "plugin": "xkey",
      "form": "tag"
    },
    {
      "code": "multi_key_exclusive_emitted",
      "severity": "info",
      "message": "form `tag` has at least one multi-key bundle in an exclusive group; emitted as `{required: [<bundle>]}` per bundle. Bundle atomicity (partial bundles fail) requires SJON-aware runtime validation",
      "plugin": "xkey",
      "form": "tag"
    }
  ],
  "$defs": {
    "form.xkey.route": {
      "type": "object",
      "description": "A route declaration. Either name both endpoints `(from + to)` or supply a single `at` waypoint.",
      "properties": {
        "$form": {
          "const": "route"
        },
        "$ns": {
          "const": "xkey"
        },
        "at": {
          "type": "object",
          "properties": {
            "$sym": {
              "type": "string"
            }
          },
          "required": [
            "$sym"
          ],
          "additionalProperties": false
        },
        "from": {
          "type": "object",
          "properties": {
            "$sym": {
              "type": "string"
            }
          },
          "required": [
            "$sym"
          ],
          "additionalProperties": false
        },
        "name": {
          "type": "object",
          "properties": {
            "$sym": {
              "type": "string"
            }
          },
          "required": [
            "$sym"
          ],
          "additionalProperties": false
        },
        "to": {
          "type": "object",
          "properties": {
            "$sym": {
              "type": "string"
            }
          },
          "required": [
            "$sym"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "$form",
        "name"
      ],
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "from",
                "to"
              ]
            },
            {
              "required": [
                "at"
              ]
            }
          ]
        }
      ],
      "unevaluatedProperties": false,
      "x-sjon-exclusive-groups": [
        {
          "cardinality": "exactly_one",
          "alternatives": [
            [
              "from",
              "to"
            ],
            [
              "at"
            ]
          ]
        }
      ]
    },
    "form.xkey.tag": {
      "type": "object",
      "description": "A tag decoration. Use `(prefix + suffix)` to flank, or `literal` alone — but never both.",
      "properties": {
        "$form": {
          "const": "tag"
        },
        "$ns": {
          "const": "xkey"
        },
        "literal": {
          "type": "string"
        },
        "name": {
          "type": "object",
          "properties": {
            "$sym": {
              "type": "string"
            }
          },
          "required": [
            "$sym"
          ],
          "additionalProperties": false
        },
        "prefix": {
          "type": "string"
        },
        "suffix": {
          "type": "string"
        }
      },
      "required": [
        "$form",
        "name"
      ],
      "allOf": [
        {
          "not": {
            "allOf": [
              {
                "required": [
                  "prefix",
                  "suffix"
                ]
              },
              {
                "required": [
                  "literal"
                ]
              }
            ]
          }
        }
      ],
      "unevaluatedProperties": false,
      "x-sjon-exclusive-groups": [
        {
          "cardinality": "at_most_one",
          "alternatives": [
            [
              "prefix",
              "suffix"
            ],
            [
              "literal"
            ]
          ]
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/form.xkey.route"
    },
    {
      "$ref": "#/$defs/form.xkey.tag"
    }
  ]
}
