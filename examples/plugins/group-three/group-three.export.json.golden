{
  "version": 2,
  "plugins": [
    {
      "name": "group-three",
      "version": "1.0.0",
      "forms": [
        {
          "name": "choice",
          "description": "Exactly one of `a`, `(b1 + b2)`, or `c`.",
          "open": false,
          "positional": "none",
          "keys": [
            {
              "name": "common",
              "optional": true,
              "description": "",
              "value": {
                "kind": "string"
              }
            },
            {
              "name": "a",
              "optional": true,
              "description": "",
              "value": {
                "kind": "string"
              }
            },
            {
              "name": "b1",
              "optional": true,
              "description": "",
              "value": {
                "kind": "string"
              }
            },
            {
              "name": "b2",
              "optional": true,
              "description": "",
              "value": {
                "kind": "number"
              }
            },
            {
              "name": "c",
              "optional": true,
              "description": "",
              "value": {
                "kind": "boolean"
              }
            }
          ]
        }
      ],
      "value_kinds": []
    }
  ],
  "warnings": [
    {
      "code": "exclusive_group_unenforceable",
      "severity": "info",
      "message": "form `choice` exclusive groups emitted structurally (`oneOf` for exactly_one, `not:{allOf}` for at_most_one); source-order constraints between variant keys and discriminants remain SJON-only",
      "plugin_name": "group-three",
      "form_name": "choice"
    },
    {
      "code": "multi_key_exclusive_emitted",
      "severity": "info",
      "message": "form `choice` has at least one multi-key bundle in an exclusive group; emitted as `{required: [<bundle>]}` per bundle. Bundle atomicity (partial bundles fail) requires SJON-aware runtime validation",
      "plugin_name": "group-three",
      "form_name": "choice"
    }
  ]
}
