{
  "version": 1,
  "plugins": [
    {
      "name": "audio",
      "version": "1.0.0",
      "forms": [
        {
          "name": "phrase",
          "description": "A note sequence, either named (a reusable definition) or anonymous (inline).",
          "open": false,
          "positional": "none",
          "keys": [
            {
              "name": "name",
              "optional": true,
              "description": "",
              "value": {
                "kind": "symbol"
              }
            },
            {
              "name": "notes",
              "optional": false,
              "description": "",
              "value": {
                "kind": "vector",
                "len": null,
                "element": {
                  "kind": "union_of",
                  "alternatives": [
                    {
                      "name": "note-or-rest",
                      "shape": {
                        "kind": "symbol_members",
                        "names": [
                          "E4",
                          "G4",
                          "A4",
                          "B4",
                          "_"
                        ]
                      }
                    },
                    {
                      "name": "event",
                      "shape": {
                        "kind": "form_heads",
                        "refs": [
                          {
                            "plugin": "audio",
                            "name": "n"
                          },
                          {
                            "plugin": "audio",
                            "name": "rest"
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "name": "track",
          "description": "A phrase slot filled inline or by reference to a named phrase.",
          "open": false,
          "positional": "none",
          "keys": [
            {
              "name": "lead",
              "optional": false,
              "description": "",
              "value": {
                "kind": "union_of",
                "alternatives": [
                  {
                    "name": "phrase-inline",
                    "shape": {
                      "kind": "form_heads",
                      "refs": [
                        {
                          "plugin": "audio",
                          "name": "phrase"
                        }
                      ]
                    }
                  },
                  {
                    "name": "phrase-ref",
                    "shape": {
                      "kind": "cross_ref",
                      "targets": [
                        "phrase"
                      ],
                      "name_key": "name",
                      "acyclic": false,
                      "scope_form": null,
                      "provider": null,
                      "source_key": null
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "name": "n",
          "description": "A pitched note event.",
          "open": false,
          "positional": "any",
          "keys": []
        },
        {
          "name": "rest",
          "description": "A rest event.",
          "open": false,
          "positional": "any",
          "keys": []
        }
      ],
      "value_kinds": [
        {
          "name": "note-or-rest",
          "description": "Pitch class or the rest mark `_`.",
          "shape": {
            "kind": "symbol_members",
            "names": [
              "E4",
              "G4",
              "A4",
              "B4",
              "_"
            ]
