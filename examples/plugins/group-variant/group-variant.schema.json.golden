{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-sjon-export-version": 2,
  "x-sjon-export-warnings": [
    {
      "code": "variants_emitted_via_if_then",
      "severity": "info",
      "message": "discriminated form `track` — variants emitted as allOf+if/then; source-order (variant keys must follow the discriminant) is not enforced by JSON Schema",
      "plugin": "group-variant",
      "form": "track"
    }
  ],
  "$defs": {
    "form.group-variant.track": {
      "type": "object",
      "description": "A track whose kick variant carries a scoped exclusive group.",
      "properties": {
        "$form": {
          "const": "track"
        },
        "$ns": {
          "const": "group-variant"
        },
        "kind": {
          "enum": [
            {
              "$sym": "kick"
            },
            {
              "$sym": "bass"
            }
          ]
        }
      },
      "required": [
        "$form"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": {
                  "$sym": "kick"
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "step": {
                "type": "number"
              },
              "sweep": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": {
                  "$sym": "bass"
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "sequence": {}
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "x-sjon-discriminant": {
        "key": "kind",
        "variants": [
          {
            "when": "kick",
            "keys": [
              "step",
              "sweep"
            ]
          },
          {
            "when": "bass",
            "keys": [
              "sequence"
            ]
          }
        ]
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/form.group-variant.track"
    }
  ]
}
