{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-sjon-export-version": 2,
  "x-sjon-export-warnings": [
    {
      "code": "exclusive_group_unenforceable",
      "severity": "info",
      "message": "form `page` exclusive groups emitted structurally (`oneOf` for exactly_one, `not:{allOf}` for at_most_one); source-order constraints between variant keys and discriminants remain SJON-only",
      "plugin": "group-open",
      "form": "page"
    }
  ],
  "$defs": {
    "form.group-open.page": {
      "type": "object",
      "description": "An open page; its group is annotation-only.",
      "properties": {
        "$form": {
          "const": "page"
        },
        "$ns": {
          "const": "group-open"
        },
        "a": {
          "type": "string"
        },
        "b": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "$form"
      ],
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "a"
              ]
            },
            {
              "required": [
                "b"
              ]
            }
          ]
        }
      ],
      "unevaluatedProperties": true,
      "x-sjon-exclusive-groups": [
        {
          "cardinality": "exactly_one",
          "alternatives": [
            [
              "a"
            ],
            [
              "b"
            ]
          ]
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/form.group-open.page"
    }
  ]
}
