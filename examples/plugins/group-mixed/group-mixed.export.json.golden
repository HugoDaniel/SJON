{
  "version": 2,
  "plugins": [
    {
      "name": "group-mixed",
      "version": "1.0.0",
      "forms": [
        {
          "name": "mixed",
          "description": "A default-free enforced group and a defaulted sibling.",
          "open": false,
          "positional": "none",
          "keys": [
            {
              "name": "a",
              "optional": true,
              "description": "",
              "value": {
                "kind": "string"
              }
            },
            {
              "name": "b",
              "optional": true,
              "description": "",
              "value": {
                "kind": "string"
              }
            },
            {
              "name": "c",
              "optional": true,
              "description": "",
              "value": {
                "kind": "number"
              }
            },
            {
              "name": "d",
              "optional": true,
              "description": "",
              "value": {
                "kind": "number"
              },
              "default": 0
            }
          ]
        }
      ],
      "value_kinds": []
    }
  ],
  "warnings": [
    {
      "code": "exclusive_group_unenforceable",
      "severity": "info",
      "message": "form `mixed` exclusive groups emitted structurally (`oneOf` for exactly_one, `not:{allOf}` for at_most_one); source-order constraints between variant keys and discriminants remain SJON-only",
      "plugin_name": "group-mixed",
      "form_name": "mixed"
    }
  ]
}
