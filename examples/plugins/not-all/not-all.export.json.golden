{
  "version": 2,
  "plugins": [
    {
      "name": "not-all",
      "version": "1.0.0",
      "forms": [
        {
          "name": "flag",
          "description": "Exactly one of `on` / `off`.",
          "open": false,
          "positional": "none",
          "keys": [
            {
              "name": "name",
              "optional": false,
              "description": "",
              "value": {
                "kind": "symbol"
              }
            },
            {
              "name": "on",
              "optional": true,
              "description": "",
              "value": {
                "kind": "boolean"
              }
            },
            {
              "name": "off",
              "optional": true,
              "description": "",
              "value": {
                "kind": "boolean"
              }
            }
          ]
        }
      ],
      "value_kinds": []
    }
  ],
  "warnings": [
    {
      "code": "exclusive_group_unenforceable",
      "severity": "info",
      "message": "form `flag` exclusive groups emitted structurally (`oneOf` for exactly_one, `not:{allOf}` for at_most_one); source-order constraints between variant keys and discriminants remain SJON-only",
      "plugin_name": "not-all",
      "form_name": "flag"
    }
  ]
}
