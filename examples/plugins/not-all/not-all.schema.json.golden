{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-sjon-export-version": 2,
  "x-sjon-export-warnings": [
    {
      "code": "exclusive_group_unenforceable",
      "severity": "info",
      "message": "form `flag` exclusive groups emitted structurally (`oneOf` for exactly_one, `not:{allOf}` for at_most_one); source-order constraints between variant keys and discriminants remain SJON-only",
      "plugin": "not-all",
      "form": "flag"
    }
  ],
  "$defs": {
    "form.not-all.flag": {
      "type": "object",
      "description": "Exactly one of `on` / `off`.",
      "properties": {
        "$form": {
          "const": "flag"
        },
        "$ns": {
          "const": "not-all"
        },
        "name": {
          "type": "object",
          "properties": {
            "$sym": {
              "type": "string"
            }
          },
          "required": [
            "$sym"
          ],
          "additionalProperties": false
        },
        "off": {
          "type": "boolean"
        },
        "on": {
          "type": "boolean"
        }
      },
      "required": [
        "$form",
        "name"
      ],
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "on"
              ]
            },
            {
              "required": [
                "off"
              ]
            }
          ]
        }
      ],
      "unevaluatedProperties": false,
      "x-sjon-exclusive-groups": [
        {
          "cardinality": "exactly_one",
          "alternatives": [
            [
              "on"
            ],
            [
              "off"
            ]
          ]
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/form.not-all.flag"
    }
  ]
}
