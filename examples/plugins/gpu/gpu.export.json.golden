{
  "version": 1,
  "plugins": [
    {
      "name": "gpu",
      "version": "1.0.0",
      "forms": [
        {
          "name": "vertex",
          "description": "One mesh vertex: a 2..4-component position plus an optional u16 tint channel.",
          "open": false,
          "positional": "none",
          "keys": [
            {
              "name": "position",
              "optional": false,
              "description": "",
              "value": {
                "kind": "vector",
                "len": null,
                "element": {
                  "kind": "number"
                }
              }
            },
            {
              "name": "tint",
              "optional": true,
              "description": "",
              "value": {
                "kind": "number_bounded",
                "bounds": {}
              }
            }
          ]
        },
        {
          "name": "draw",
          "description": "A draw call: f32 line width, u32 base vertex, and a bare LOD bias.",
          "open": false,
          "positional": "none",
          "keys": [
            {
              "name": "line-width",
              "optional": false,
              "description": "",
              "value": {
                "kind": "number_bounded",
                "bounds": {}
              }
            },
            {
              "name": "base-vertex",
              "optional": false,
              "description": "",
              "value": {
                "kind": "number_bounded",
                "bounds": {}
              }
            },
            {
              "name": "lod-bias",
              "optional": true,
              "description": "",
              "value": {
                "kind": "number"
              }
            }
          ]
        },
        {
          "name": "target",
          "description": "A colour target's masks, written in hex.",
          "open": false,
          "positional": "none",
          "keys": [
            {
              "name": "write-mask",
              "optional": true,
              "description": "",
              "value": {
                "kind": "number_bounded",
                "bounds": {}
              }
            },
            {
              "name": "sample-mask",
              "optional": true,
              "description": "",
              "value": {
                "kind": "number_bounded",
                "bounds": {}
              }
            }
          ]
        }
      ],
      "value_kinds": [
        {
          "name": "channel",
          "description": "Normalized colour channel encoded as a u16: an integer in [0, 65535].",
          "shape": {
            "kind": "number_bounded",
            "bounds": {}
          }
        },
        {
          "name": "scalar",
          "description": "A 32-bit float scalar (line width, bias, …). Floats carry no integrality constraint.",
          "shape": {
            "kind": "number_bounded",
            "bounds": {}
          }
        },
        {
          "name": "vertex-index",
          "description": "Index into a vertex buffer: a non-negative integer in [0, 2^32).",
          "shape": {
            "kind": "number_bounded",
            "bounds": {}
          }
        },
        {
          "name": "attribute",
          "description": "A vertex attribute of 2 to 4 float components (vec2..vec4).",
          "shape": {
            "kind": "vector",
            "len": null,
            "element": {
              "kind": "number"
            }
          }
        },
        {
          "name": "raw-uniform",
          "description": "A raw uniform or push-constant value: a bare number only, never a unit suffix.",
          "shape": {
            "kind": "number"
          }
        },
        {
          "name": "u32-mask",
          "description": "A 32-bit write/sample mask. Write it in hex (0xFFFFFFFF, 0xF) the way the WebGPU spec does.",
          "shape": {
            "kind": "number_bounded",
            "bounds": {}
          }
        }
      ]
    }
  ],
  "warnings": []
}
