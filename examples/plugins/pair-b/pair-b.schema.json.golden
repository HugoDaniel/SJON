{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-sjon-export-version": 1,
  "$defs": {
    "form.pair-b.color": {
      "type": "object",
      "description": "A solid colour swatch.",
      "properties": {
        "$form": {
          "const": "color"
        },
        "$ns": {
          "const": "pair-b"
        },
        "hex": {
          "description": "Hex `#RRGGBB`.",
          "type": "string"
        },
        "name": {
          "type": "object",
          "properties": {
            "$sym": {
              "type": "string"
            }
          },
          "required": [
            "$sym"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "$form",
        "hex"
      ],
      "additionalProperties": false
    },
    "form.pair-b.gradient": {
      "type": "object",
      "description": "A two-stop linear gradient.",
      "properties": {
        "$form": {
          "const": "gradient"
        },
        "$ns": {
          "const": "pair-b"
        },
        "angle": {
          "type": "number"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "$form",
        "from",
        "to"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/form.pair-b.color"
    },
    {
      "$ref": "#/$defs/form.pair-b.gradient"
    }
  ]
}
