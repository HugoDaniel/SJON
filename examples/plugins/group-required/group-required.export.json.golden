{
  "version": 2,
  "plugins": [
    {
      "name": "group-required",
      "version": "1.0.0",
      "forms": [
        {
          "name": "req",
          "description": "Both grouped keys are required in their own arms.",
          "open": false,
          "positional": "none",
          "keys": [
            {
              "name": "keep",
              "optional": false,
              "description": "",
              "value": {
                "kind": "string"
              }
            },
            {
              "name": "a",
              "optional": false,
              "description": "",
              "value": {
                "kind": "number"
              }
            },
            {
              "name": "b",
              "optional": false,
              "description": "",
              "value": {
                "kind": "number"
              }
            }
          ]
        },
        {
          "name": "either",
          "description": "At-most-one over required keys: the none-arm omits both.",
          "open": false,
          "positional": "none",
          "keys": [
            {
              "name": "tag",
              "optional": false,
              "description": "",
              "value": {
                "kind": "string"
              }
            },
            {
              "name": "c",
              "optional": false,
              "description": "",
              "value": {
                "kind": "number"
              }
            },
            {
              "name": "d",
              "optional": false,
              "description": "",
              "value": {
                "kind": "number"
              }
            }
          ]
        }
      ],
      "value_kinds": []
    }
  ],
  "warnings": [
    {
      "code": "exclusive_group_unenforceable",
      "severity": "info",
      "message": "form `req` exclusive groups emitted structurally (`oneOf` for exactly_one, `not:{allOf}` for at_most_one); source-order constraints between variant keys and discriminants remain SJON-only",
      "plugin_name": "group-required",
      "form_name": "req"
    },
    {
      "code": "exclusive_group_unenforceable",
      "severity": "info",
      "message": "form `either` exclusive groups emitted structurally (`oneOf` for exactly_one, `not:{allOf}` for at_most_one); source-order constraints between variant keys and discriminants remain SJON-only",
      "plugin_name": "group-required",
      "form_name": "either"
    }
  ]
}
