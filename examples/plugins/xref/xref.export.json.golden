{
  "version": 1,
  "plugins": [
    {
      "name": "xref",
      "version": "1.0.0",
      "forms": [
        {
          "name": "node",
          "description": "Named graph node. Referenced by `:edge`.",
          "open": false,
          "positional": "none",
          "keys": [
            {
              "name": "id",
              "optional": false,
              "description": "Stable identifier within the document.",
              "value": {
                "kind": "symbol"
              }
            },
            {
              "name": "label",
              "optional": true,
              "description": "",
              "value": {
                "kind": "string"
              }
            },
            {
              "name": "parent",
              "optional": true,
              "description": "",
              "value": {
                "kind": "cross_ref",
                "targets": [
                  "node"
                ],
                "name_key": "id",
                "acyclic": true,
                "scope_form": null,
                "provider": null,
                "source_key": null
              }
            }
          ]
        },
        {
          "name": "phrase",
          "description": "Composable phrase. Referenced by `:phrase-ref` (scope-form scoped to a parent `(piece …)`).",
          "open": false,
          "positional": "none",
          "keys": [
            {
              "name": "name",
              "optional": false,
              "description": "",
              "value": {
                "kind": "symbol"
              }
            },
            {
              "name": "body",
              "optional": true,
              "description": "",
              "value": {
                "kind": "string"
              }
            }
          ]
        },
        {
          "name": "piece",
          "description": "Scope-form root for nested `(phrase …)` registries.",
          "open": false,
          "positional": "any",
          "keys": [
            {
              "name": "title",
              "optional": false,
              "description": "",
              "value": {
                "kind": "string"
              }
            }
          ]
        },
        {
          "name": "shader",
          "description": "Opaque source blob. Its `:code` string is the member set for `:uniform-ref`, read by the `uniforms` provider.",
          "open": false,
          "positional": "none",
          "keys": [
            {
              "name": "name",
              "optional": false,
              "description": "",
              "value": {
                "kind": "symbol"
              }
            },
            {
              "name": "code",
              "optional": false,
              "description": "",
              "value": {
                "kind": "string"
              }
            }
          ]
        },
        {
          "name": "render-pipeline",
          "description": "A raster pipeline. One half of the ambiguous pair.",
          "open": false,
          "positional": "none",
          "keys": [
            {
              "name": "name",
              "optional": false,
              "description": "",
              "value": {
                "kind": "symbol"
              }
            }
          ]
        },
        {
          "name": "compute-pipeline",
          "description": "A compute pipeline. The other half.",
          "open": false,
          "positional": "none",
          "keys": [
            {
              "name": "name",
              "optional": false,
              "description": "",
              "value": {
                "kind": "symbol"
              }
            }
          ]
        },
        {
          "name": "edge",
          "description": "Directed edge between two `(node …)` declarations.",
          "open": false,
          "positional": "none",
          "keys": [
            {
              "name": "from",
              "optional": false,
              "description": "",
              "value": {
                "kind": "cross_ref",
                "targets": [
                  "node"
                ],
                "name_key": "id",
                "acyclic": false,
                "scope_form": null,
                "provider": null,
                "source_key": null
              }
            },
            {
              "name": "to",
              "optional": false,
              "description": "",
              "value": {
                "kind": "cross_ref",
                "targets": [
                  "node"
                ],
                "name_key": "id",
                "acyclic": true,
                "scope_form": null,
                "provider": null,
                "source_key": null
              }
            },
            {
              "name": "phrase",
              "optional": true,
              "description": "",
              "value": {
                "kind": "cross_ref",
                "targets": [
                  "phrase"
                ],
                "name_key": "name",
                "acyclic": false,
                "scope_form": "piece",
                "provider": null,
                "source_key": null
              }
            },
            {
              "name": "uniform",
              "optional": true,
              "description": "",
              "value": {
                "kind": "cross_ref",
                "targets": [
                  "shader"
                ],
                "name_key": "name",
                "acyclic": false,
                "scope_form": null,
                "provider": "uniforms",
                "source_key": "code"
              }
            },
            {
              "name": "pipeline",
              "optional": true,
              "description": "",
              "value": {
                "kind": "union_of",
                "alternatives": [
                  {
                    "name": "render-pipeline-ref",
                    "shape": {
                      "kind": "cross_ref",
                      "targets": [
                        "render-pipeline"
                      ],
                      "name_key": "name",
                      "acyclic": false,
                      "scope_form": null,
                      "provider": null,
                      "source_key": null
                    }
                  },
                  {
                    "name": "compute-pipeline-ref",
                    "shape": {
                      "kind": "cross_ref",
                      "targets": [
                        "compute-pipeline"
                      ],
                      "name_key": "name",
                      "acyclic": false,
                      "scope_form": null,
                      "provider": null,
                      "source_key": null
                    }
                  }
                ]
              }
            },
            {
              "name": "group-pipeline",
              "optional": true,
              "description": "",
              "value": {
                "kind": "cross_ref",
                "targets": [
                  "render-pipeline",
                  "compute-pipeline"
                ],
                "name_key": "name",
                "acyclic": false,
                "scope_form": null,
                "provider": null,
                "source_key": null
              }
            }
          ]
        }
      ],
      "value_kinds": [
        {
          "name": "node-ref",
          "description": "Cross-ref to a `(node …)` declared elsewhere.",
          "shape": {
            "kind": "cross_ref",
            "targets": [
              "node"
            ],
            "name_key": "id",
            "acyclic": false,
            "scope_form": null,
            "provider": null,
            "source_key": null
          }
        },
        {
          "name": "node-acyclic",
          "description": "Acyclic cross-ref to a `(node …)`.",
          "shape": {
            "kind": "cross_ref",
            "targets": [
              "node"
            ],
            "name_key": "id",
            "acyclic": true,
            "scope_form": null,
            "provider": null,
            "source_key": null
          }
        },
        {
          "name": "phrase-ref",
          "description": "Cross-ref to a `(phrase …)` declared within the enclosing `(piece …)`.",
          "shape": {
            "kind": "cross_ref",
            "targets": [
              "phrase"
            ],
            "name_key": "name",
            "acyclic": false,
            "scope_form": "piece",
            "provider": null,
            "source_key": null
          }
        },
        {
          "name": "uniform-ref",
          "description": "Cross-ref to a uniform declared inside some `(shader …)`'s source.",
          "shape": {
            "kind": "cross_ref",
            "targets": [
              "shader"
            ],
            "name_key": "name",
            "acyclic": false,
            "scope_form": null,
            "provider": "uniforms",
            "source_key": "code"
          }
        },
        {
          "name": "render-pipeline-ref",
          "description": "Cross-ref to a `(render-pipeline …)`.",
          "shape": {
            "kind": "cross_ref",
            "targets": [
              "render-pipeline"
            ],
            "name_key": "name",
            "acyclic": false,
            "scope_form": null,
            "provider": null,
            "source_key": null
          }
        },
        {
          "name": "compute-pipeline-ref",
          "description": "Cross-ref to a `(compute-pipeline …)`.",
          "shape": {
            "kind": "cross_ref",
            "targets": [
              "compute-pipeline"
            ],
            "name_key": "name",
            "acyclic": false,
            "scope_form": null,
            "provider": null,
            "source_key": null
          }
        },
        {
          "name": "pipeline-ref",
          "description": "Either pipeline, tried in this order: render first.",
          "shape": {
            "kind": "union_of",
            "alternatives": [
              {
                "name": "render-pipeline-ref",
                "shape": {
                  "kind": "cross_ref",
                  "targets": [
                    "render-pipeline"
                  ],
                  "name_key": "name",
                  "acyclic": false,
                  "scope_form": null,
                  "provider": null,
                  "source_key": null
                }
              },
              {
                "name": "compute-pipeline-ref",
                "shape": {
                  "kind": "cross_ref",
                  "targets": [
                    "compute-pipeline"
                  ],
                  "name_key": "name",
                  "acyclic": false,
                  "scope_form": null,
                  "provider": null,
                  "source_key": null
                }
              }
            ]
          }
        },
        {
          "name": "pipeline-group-ref",
          "description": "Either pipeline, in one namespace, so a name defined by both is a duplicate.",
          "shape": {
            "kind": "cross_ref",
            "targets": [
              "render-pipeline",
              "compute-pipeline"
            ],
            "name_key": "name",
            "acyclic": false,
            "scope_form": null,
            "provider": null,
            "source_key": null
          }
        }
      ]
    }
  ],
  "warnings": [
    {
      "code": "cross_ref_unenforceable",
      "severity": "warn",
      "message": "value-kind `node-acyclic` cross-ref: schema validates symbol shape only; closed-set membership requires SJON-aware validator",
      "plugin_name": "xref",
      "kind_name": "node-acyclic"
    },
    {
      "code": "cross_ref_annotation_only",
      "severity": "info",
      "message": "value-kind `node-acyclic` cross-ref annotation surfaces target-form=`node` name-key=`id` acyclic=true scope-form=``; none are enforceable by JSON Schema",
      "plugin_name": "xref",
      "kind_name": "node-acyclic"
    },
    {
      "code": "acyclic_unenforceable",
      "severity": "warn",
      "message": "value-kind `node-acyclic` declares `:acyclic true`; cycle detection cannot be enforced by JSON Schema",
      "plugin_name": "xref",
      "kind_name": "node-acyclic"
    },
    {
      "code": "cross_ref_unenforceable",
      "severity": "warn",
      "message": "value-kind `node-ref` cross-ref: schema validates symbol shape only; closed-set membership requires SJON-aware validator",
      "plugin_name": "xref",
      "kind_name": "node-ref"
    },
    {
      "code": "cross_ref_annotation_only",
      "severity": "info",
      "message": "value-kind `node-ref` cross-ref annotation surfaces target-form=`node` name-key=`id` acyclic=false scope-form=``; none are enforceable by JSON Schema",
      "plugin_name": "xref",
      "kind_name": "node-ref"
    },
    {
      "code": "cross_ref_unenforceable",
      "severity": "warn",
      "message": "value-kind `phrase-ref` cross-ref: schema validates symbol shape only; closed-set membership requires SJON-aware validator",
      "plugin_name": "xref",
      "kind_name": "phrase-ref"
    },
    {
      "code": "cross_ref_annotation_only",
      "severity": "info",
      "message": "value-kind `phrase-ref` cross-ref annotation surfaces target-form=`phrase` name-key=`name` acyclic=false scope-form=`piece`; none are enforceable by JSON Schema",
      "plugin_name": "xref",
      "kind_name": "phrase-ref"
    },
    {
      "code": "cross_ref_unenforceable",
      "severity": "warn",
      "message": "value-kind `uniform-ref` cross-ref: schema validates symbol shape only; the member set is extracted from each target's `:code` string by provider `uniforms` during validation, so it is not knowable at export time",
      "plugin_name": "xref",
      "kind_name": "uniform-ref"
    },
    {
      "code": "cross_ref_annotation_only",
      "severity": "info",
      "message": "value-kind `uniform-ref` cross-ref annotation surfaces target-form=`shader` provider=`uniforms` source-key=`code` scope-form=``; none are enforceable by JSON Schema",
      "plugin_name": "xref",
      "kind_name": "uniform-ref"
    },
    {
      "code": "union_emitted_via_anyof",
      "severity": "info",
      "message": "value-kind `pipeline-ref` union_of emitted as JSON Schema `anyOf` over resolved alternatives; SJON's first-match dispatch order is preserved in `x-sjon-union-alternatives`",
      "plugin_name": "xref",
      "kind_name": "pipeline-ref"
    },
    {
      "code": "cross_ref_unenforceable",
      "severity": "warn",
      "message": "value-kind `render-pipeline-ref` cross-ref: schema validates symbol shape only; closed-set membership requires SJON-aware validator",
      "plugin_name": "xref",
      "kind_name": "render-pipeline-ref"
    },
    {
      "code": "cross_ref_annotation_only",
      "severity": "info",
      "message": "value-kind `render-pipeline-ref` cross-ref annotation surfaces target-form=`render-pipeline` name-key=`name` acyclic=false scope-form=``; none are enforceable by JSON Schema",
      "plugin_name": "xref",
      "kind_name": "render-pipeline-ref"
    },
    {
      "code": "cross_ref_unenforceable",
      "severity": "warn",
      "message": "value-kind `compute-pipeline-ref` cross-ref: schema validates symbol shape only; closed-set membership requires SJON-aware validator",
      "plugin_name": "xref",
      "kind_name": "compute-pipeline-ref"
    },
    {
      "code": "cross_ref_annotation_only",
      "severity": "info",
      "message": "value-kind `compute-pipeline-ref` cross-ref annotation surfaces target-form=`compute-pipeline` name-key=`name` acyclic=false scope-form=``; none are enforceable by JSON Schema",
      "plugin_name": "xref",
      "kind_name": "compute-pipeline-ref"
    },
    {
      "code": "cross_ref_unenforceable",
      "severity": "warn",
      "message": "value-kind `pipeline-group-ref` cross-ref: schema validates symbol shape only; closed-set membership requires SJON-aware validator",
      "plugin_name": "xref",
      "kind_name": "pipeline-group-ref"
    },
    {
      "code": "cross_ref_annotation_only",
      "severity": "info",
      "message": "value-kind `pipeline-group-ref` cross-ref annotation surfaces target-form=`render-pipeline | compute-pipeline` name-key=`name` acyclic=false scope-form=``; none are enforceable by JSON Schema",
      "plugin_name": "xref",
      "kind_name": "pipeline-group-ref"
    }
  ]
}
