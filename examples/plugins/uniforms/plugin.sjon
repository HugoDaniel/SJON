; Provider-backed cross-refs, end to end — the general route, actually
; running. The sibling `examples/plugins/xref/` fixture declares all
; four `(cross-ref …)` axes but ships no `:impl` (export never executes
; an extractor); this example is the other half: a provider with a real
; implementation (`plugin.wasm`, built from `uniforms_provider.zig` by
; `zig build plugin-fixtures`), so validating the `scene*.sjon` siblings
; extracts, registers, and resolves for real.
;
; The idea in one line: `(bind :uniform u_time)` is checked against
; names that exist nowhere in the document's own syntax — they are
; inside each `(shader :src "…")` WGSL string, and the `uniforms`
; provider is the one consumer allowed to see into it. The blob stays
; opaque to SJON; validation stays a pure function of
; (document, schema, pinned plugin set).
;
; `:sjon "1.2"` is the manifest format that introduced
; `(cross-ref-provider …)` and `(cross-ref :provider/:source-key …)`.
; A host that predates it refuses the whole manifest with
; `sjon_format_unsupported` rather than silently ignoring the vocabulary.
(plugin :name uniforms :version "1.0.0" :sjon "1.2"
  (cross-ref-provider :name uniforms
    :description "WGSL uniform declarations: the name of every module-scope `var<uniform>` in the source."
    :impl "wasm:extract_uniforms")

  (form :name shader
    :description "A WGSL module. Its `:src` string is the member set for `uniform-ref`, read by the `uniforms` provider — `:name` is just a key, the provider route never touches it."
    (key :name name :type symbol :optional false)
    (key :name src :type string :optional false))

  ; The provider route: `:provider` replaces `:name-key` as the source
  ; of names, and `:source-key` names the string it reads (`src` is the
  ; default; spelled out here because this file is for reading). The two
  ; are exclusive — a cross-ref naming both a provider and a `:name-key`
  ; is rejected at manifest load.
  (value-kind :name uniform-ref
    :description "A uniform declared inside some `(shader …)`'s WGSL source."
    :underlying symbol
    :cross-ref (cross-ref :target shader :provider uniforms :source-key src))

  (form :name bind
    :description "Binds one extracted uniform to a bind-group slot."
    (key :name uniform :type uniform-ref :optional false)
    (key :name group :type number :optional true)
    (key :name binding :type number :optional true)))
