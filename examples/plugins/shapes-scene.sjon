; Sample scene exercising the `shapes` reference plugin.
;
; Demonstrates:
;   * `:open` form (`scene`) accepting ad-hoc metadata keywords (:author).
;   * Nested forms — canvas contains shapes, group contains shapes.
;   * Value-typed keywords: :radius is a `length`, :center / :origin are points.
;   * Safe expressions in value position: (* 2 1.5) for :radius, (+ 0 320) for :w.
;   * Comments — both leading and trailing — round-trip via the lossless printer.

(scene :title "shapes demo" :author "ada"

  (canvas :w (+ 0 320) :h 240 :bg "black"

    ; A solid disc dead-centre.
    (circle :center [160 120] :radius (* 2 16))

    (group :name "border"
      (rect :origin [0 0]   :size [320 4])
      (rect :origin [0 236] :size [320 4])
      (rect :origin [0 0]   :size [4 240])
      (rect :origin [316 0] :size [4 240]))

    ; Two side circles whose radius is a parameterised expression.
    (circle :center [40  120] :radius (clamp 8 0 16))
    (circle :center [280 120] :radius (clamp 8 0 16))))
