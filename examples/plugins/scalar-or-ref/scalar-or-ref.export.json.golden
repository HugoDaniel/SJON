{
  "version": 1,
  "plugins": [
    {
      "name": "scalar-or-ref",
      "version": "1.0.0",
      "forms": [
        {
          "name": "define",
          "description": "A named constant a dimension may reference.",
          "open": false,
          "positional": "none",
          "keys": [
            {
              "name": "name",
              "optional": false,
              "description": "",
              "value": {
                "kind": "symbol"
              }
            },
            {
              "name": "value",
              "optional": false,
              "description": "",
              "value": {
                "kind": "number"
              }
            }
          ]
        },
        {
          "name": "dispatch",
          "description": "A compute dispatch sized on three axes; each axis is a literal or a named reference.",
          "open": false,
          "positional": "none",
          "keys": [
            {
              "name": "x",
              "optional": false,
              "description": "",
              "value": {
                "kind": "union_of",
                "alternatives": [
                  {
                    "name": "dim-value",
                    "shape": {
                      "kind": "number"
                    }
                  },
                  {
                    "name": "symbol",
                    "shape": {
                      "kind": "symbol"
                    }
                  }
                ]
              }
            },
            {
              "name": "y",
              "optional": false,
              "description": "",
              "value": {
                "kind": "union_of",
                "alternatives": [
                  {
                    "name": "dim-value",
                    "shape": {
                      "kind": "number"
                    }
                  },
                  {
                    "name": "symbol",
                    "shape": {
                      "kind": "symbol"
                    }
                  }
                ]
              }
            },
            {
              "name": "z",
              "optional": true,
              "description": "",
              "value": {
                "kind": "union_of",
                "alternatives": [
                  {
                    "name": "dim-value",
                    "shape": {
                      "kind": "number"
                    }
                  },
                  {
                    "name": "symbol",
                    "shape": {
                      "kind": "symbol"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "name": "checked-dispatch",
          "description": "As (dispatch …), but every axis reference is checked against a (define …).",
          "open": false,
          "positional": "none",
          "keys": [
            {
              "name": "x",
              "optional": false,
              "description": "",
              "value": {
                "kind": "union_of",
                "alternatives": [
                  {
                    "name": "dim-value",
                    "shape": {
                      "kind": "number"
                    }
                  },
                  {
                    "name": "define-ref",
                    "shape": {
                      "kind": "cross_ref",
                      "targets": [
                        "define"
                      ],
                      "name_key": "name",
                      "acyclic": false,
                      "scope_form": null,
                      "provider": null,
                      "source_key": null
                    }
                  }
                ]
              }
            },
            {
              "name": "y",
              "optional": true,
              "description": "",
              "value": {
                "kind": "union_of",
                "alternatives": [
                  {
                    "name": "dim-value",
                    "shape": {
                      "kind": "number"
                    }
                  },
                  {
                    "name": "define-ref",
                    "shape": {
                      "kind": "cross_ref",
                      "targets": [
                        "define"
                      ],
                      "name_key": "name",
                      "acyclic": false,
                      "scope_form": null,
                      "provider": null,
                      "source_key": null
                    }
                  }
                ]
              }
            }
          ]
        }
      ],
      "value_kinds": [
        {
          "name": "dim-value",
          "description": "A literal workgroup dimension.",
          "shape": {
            "kind": "number"
          }
        },
        {
          "name": "dim",
          "description": "A workgroup dimension: a literal count, or a symbol referencing a named constant.",
          "shape": {
            "kind": "union_of",
            "alternatives": [
              {
                "name": "dim-value",
                "shape": {
                  "kind": "number"
                }
              },
              {
                "name": "symbol",
                "shape": {
                  "kind": "symbol"
                }
              }
            ]
          }
        },
        {
          "name": "define-ref",
          "description": "A symbol naming a (define …) in this document.",
          "shape": {
            "kind": "cross_ref",
            "targets": [
              "define"
            ],
            "name_key": "name",
            "acyclic": false,
            "scope_form": null,
            "provider": null,
            "source_key": null
          }
        },
        {
          "name": "checked-dim",
          "description": "A workgroup dimension whose reference half must name a real (define …).",
          "shape": {
            "kind": "union_of",
            "alternatives": [
              {
                "name": "dim-value",
                "shape": {
                  "kind": "number"
                }
              },
              {
                "name": "define-ref",
                "shape": {
                  "kind": "cross_ref",
                  "targets": [
                    "define"
                  ],
                  "name_key": "name",
                  "acyclic": false,
                  "scope_form": null,
                  "provider": null,
                  "source_key": null
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "warnings": [
    {
      "code": "union_emitted_via_anyof",
      "severity": "info",
      "message": "value-kind `dim` union_of emitted as JSON Schema `anyOf` over resolved alternatives; SJON's first-match dispatch order is preserved in `x-sjon-union-alternatives`",
      "plugin_name": "scalar-or-ref",
      "kind_name": "dim"
    },
    {
      "code": "union_emitted_via_anyof",
      "severity": "info",
      "message": "value-kind `checked-dim` union_of emitted as JSON Schema `anyOf` over resolved alternatives; SJON's first-match dispatch order is preserved in `x-sjon-union-alternatives`",
      "plugin_name": "scalar-or-ref",
      "kind_name": "checked-dim"
    },
    {
      "code": "cross_ref_unenforceable",
      "severity": "warn",
      "message": "value-kind `define-ref` cross-ref: schema validates symbol shape only; closed-set membership requires SJON-aware validator",
      "plugin_name": "scalar-or-ref",
      "kind_name": "define-ref"
    },
    {
      "code": "cross_ref_annotation_only",
      "severity": "info",
      "message": "value-kind `define-ref` cross-ref annotation surfaces target-form=`define` name-key=`name` acyclic=false scope-form=``; none are enforceable by JSON Schema",
      "plugin_name": "scalar-or-ref",
      "kind_name": "define-ref"
    }
  ]
}
