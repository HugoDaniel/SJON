# Build artifacts
zig-out/
.zig-cache/

# Test artifacts
*.test

# IDE/Editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# JS/TS workspace dependencies (pnpm)
node_modules/
hosts/typescript-parity/node_modules/
hosts/web/node_modules/

# VS Code extension bundle (emitted by `pnpm --filter sjon-vscode run bundle`)
editors/vscode/dist/

# Rust host build artifacts
hosts/rust/target/
hosts/rust/Cargo.lock

# Local working areas (not part of the release)
.claude/
# Anchored: the repo is itself named SJON, so an unanchored `SJON/` would
# silently hide any directory of that name at any depth — a source dir, a
# fixture dir, a host package — not just the root-level notes vault this is
# for. `.mirrorignore` already anchors its copy.
/SJON/
.playwright-mcp/
# Assessment / audit scratch notes live under docs/notes/, untracked by design.
/docs/notes/

# Landing page build outputs
landing-page/node_modules/
landing-page/dist/
landing-page/.astro/

# web-todo demo artifacts (staged by `zig build web-todo`)
examples/web-todo/sjon.wasm
examples/web-todo/todo-plugin.wasm

# Browser-ESM build of the web host (emitted by `zig build web-host-browser`)
hosts/web/dist/

# Playground WASM + its staleness sidecar (staged by `zig build landing-page-assets`)
landing-page/public/sjon-lsp.wasm
landing-page/public/sjon-lsp.meta.json
