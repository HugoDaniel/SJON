; Partial multi-key bundle: author sets `:from` but leaves `:to` out.
; The bundle is all-or-nothing; the dedicated `exclusive_bundle_partial`
; diagnostic fires instead of `required_one_of_missing`, naming which
; sibling is missing.
(plugin :name routes :version "1.0.0"
  (form :name route
    (key :name from :type symbol :optional true)
    (key :name to :type symbol :optional true)
    (key :name at :type symbol :optional true)
    (exclusive-group :cardinality exactly-one
      (alt :keys [from to])
      (alt :keys [at]))))

(route :from a)
