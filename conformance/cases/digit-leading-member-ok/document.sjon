; A `:symbol` member-set may declare a digit-leading spelling — `1d`, `2d`,
; `3d` — the way the WebGPU spec spells `GPUTextureDimension`. None of
; those can be written as a bare symbol: the lexer reads a digit-leading
; token as a unit-bearing number (magnitude `2`, unit `d`).
;
; Two shapes are declared here because both had to change. `:values` is
; the compact spelling; `(member :name 2d …)` is the rich one, which also
; shows a digit-leading member carrying ordinary editor metadata.
;
; A mixed set is the realistic case: `GPUTextureViewDimension` has
; digit-leading members and plain symbol ones side by side, and neither is
; mistaken for the other.
(plugin :name gpu :version "1.0.0" :sjon "1.3"
  (value-kind :name texture-dimension :underlying symbol
    :members (member-set :values [1d 2d 3d]))

  (value-kind :name view-dimension :underlying symbol
    :members (member-set
      (member :name 1d)
      (member :name 2d :description "The default.")
      (member :name cube)
      (member :name cube-array)
      (member :name 3d)))

  (form :name texture
    (key :name name      :type symbol)
    (key :name dimension :type texture-dimension :optional true)
    (key :name view      :type view-dimension    :optional true)))

(texture :name albedo :dimension 2d :view 2d)
(texture :name volume :dimension 3d :view cube)
(texture :name line   :dimension 1d :view cube-array)
