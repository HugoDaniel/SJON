; A member literal that fails the declared :format is rejected at
; manifest-load time.
(plugin :name string-bounds-invalid-member-violates-format :version "1.0.0"
  (value-kind :name ss
    :underlying string
    :members (member-set :values [nope])
    :string-bounds (string-bounds :format email))
  (form :name set
    (key :name v :type ss :optional false)))
