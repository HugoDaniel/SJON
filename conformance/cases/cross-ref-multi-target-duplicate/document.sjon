; One namespace means a name defined twice inside it collides — even
; though the two definitions are different *forms*.
;
; This is the diagnostic a `:union` of two cross-ref kinds could never
; produce: there, each alternative has its own namespace, `same` is a
; valid name in both, and every reference silently resolves to whichever
; alternative is listed first. Here it is caught at the declarations.
;
; `duplicate_cross_ref_target` is the existing code, whose explanation
; already says "within one cross-ref's target scope" — a group is one
; such scope, so the sentence stays true with no new code.
(plugin :name gpu :version "1.0.0"
  (value-kind :name pipeline-ref :underlying symbol
    :cross-ref (cross-ref :target [render-pipeline compute-pipeline]))

  (form :name render-pipeline
    (key :name name :type symbol))

  (form :name compute-pipeline
    (key :name name :type symbol))

  (form :name dispatch
    (key :name pipeline :type pipeline-ref)))

(render-pipeline  :name same)
(compute-pipeline :name same)

(dispatch :pipeline same)
