; A rich `(member-set …)` declares `:archived` as deprecated, but the
; document uses the non-deprecated `:draft`. No diagnostics — the
; warning fires only on actual use.
(plugin :name deprecated-not-used :version "1.0.0"
  (value-kind :name status
    :underlying symbol
    :members (member-set
      (member :name draft     :label "Draft")
      (member :name published :label "Published")
      (member :name archived  :deprecated true)))
  (form :name post
    (key :name status :type status :optional false)))
