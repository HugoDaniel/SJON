; All-in-range vector elements pass element-wise validation.
(plugin :name numeric-vector-elementwise-pass :version "1.0.0"
  (value-kind :name opacity
    :underlying number
    :numeric (numeric-bounds :min 0 :max 1))
  (value-kind :name opacities
    :underlying vector
    :vector (vector-shape :element opacity))
  (form :name set
    (key :name v :type opacities :optional false)))
