; The hook still runs (surface gate is shape-only per v2). The
; emitted `(link :from main :to nowhere)` fails forest-wide
; cross-ref because no form named `nowhere` declares the target.
; `not_cross_ref` fires from the validator's author-path check
; against the lowered link form. Conformance asserts (code, path)
; only; Host_tests pins the source-side provenance trace.
(plugin :name probe :version "1.0.0"
  (value-kind :name target-ref :underlying symbol
    :cross-ref (cross-ref :target target))
  (value-kind :name asset-kind :underlying symbol
    :members (member-set :values [static dynamic]))
  (form :name bundle
    (key :name name :type symbol :optional false)
    (key :name target :type symbol :optional false)
    (key :name kind :type asset-kind :optional true)
    :lowering (lowering :hook test/bundle-v1 :produces [asset link]))
  (form :name asset
    (key :name name :type symbol :optional false)
    (key :name kind :type asset-kind :optional true))
  (form :name link
    (key :name from :type symbol :optional false)
    (key :name to :type target-ref :optional false))
  (form :name target
    (key :name name :type symbol :optional false)))

(target :name hero)
(bundle :name main :target nowhere :kind static)
