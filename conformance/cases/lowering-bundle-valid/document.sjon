; D8-consumer happy path. `test/bundle-v1` reads :name/:target/:kind
; through EffectiveView and emits two forms: (asset :name main-asset
; :kind static) + (link :from main :to hero). The forest-wide
; cross-ref index resolves `:to hero` against the source-tree
; `(target :name hero)`. Clean.
(plugin :name probe :version "1.0.0"
  (value-kind :name target-ref :underlying symbol
    :cross-ref (cross-ref :target target))
  (value-kind :name asset-kind :underlying symbol
    :members (member-set :values [static dynamic]))
  (form :name bundle
    (key :name name :type symbol :optional false)
    (key :name target :type symbol :optional false)
    (key :name kind :type asset-kind :optional true)
    :lowering (lowering :hook test/bundle-v1 :produces [asset link]))
  (form :name asset
    (key :name name :type symbol :optional false)
    (key :name kind :type asset-kind :optional true))
  (form :name link
    (key :name from :type symbol :optional false)
    (key :name to :type target-ref :optional false))
  (form :name target
    (key :name name :type symbol :optional false)))

(target :name hero)
(bundle :name main :target hero :kind static)
