; Multi-key alternative: `(alt :keys [from to])` vs `(alt :keys [at])`.
; Author supplies the full bundle (`:from` and `:to`) — exclusive-group
; `exactly-one` cardinality satisfied, no diagnostics.
(plugin :name routes :version "1.0.0"
  (form :name route
    (key :name from :type symbol :optional true)
    (key :name to :type symbol :optional true)
    (key :name at :type symbol :optional true)
    (exclusive-group :cardinality exactly-one
      (alt :keys [from to])
      (alt :keys [at]))))

(route :from a :to b)
