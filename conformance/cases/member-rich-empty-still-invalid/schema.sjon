; An empty `(member-set)` — no `:values`, no `(member …)` children — is
; an authoring error. The loader emits `invalid_manifest` at the
; `(member-set)` head with path `[projection members]`.
(plugin :name rich-empty-invalid :version "1.0.0"
  (value-kind :name projection
    :underlying symbol
    :members (member-set))
  (form :name cam
    (key :name mode :type projection :optional false)))
