; :numeric is only meaningful when :underlying is number; the loader
; rejects it on any other underlying with `numeric_bounds_invalid`.
(plugin :name numeric-bounds-invalid-non-number-underlying :version "1.0.0"
  (value-kind :name nn
    :underlying string
    :numeric (numeric-bounds :min 0))
  (form :name set
    (key :name v :type nn :optional false)))
