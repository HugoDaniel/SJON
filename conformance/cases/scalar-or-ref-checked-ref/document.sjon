; `(scalar-or-ref-shape :base <kind> :ref <kind>)` — the reference half of
; the shorthand, named rather than left as the default `symbol`.
;
; The default makes the reference half an *unchecked* name: any symbol at
; all satisfies it, so a misspelled constant validates clean (see
; `scalar-or-ref-default-symbol`). Naming a cross-ref kind there makes the
; reference half checked, and a misspelling is caught.
;
; The desugar is pure load-time: the stored kind is an ordinary
; `union [bone-count define-ref]`, so the diagnostic is the union's
; `union_no_branch_matched` naming both alternatives — NOT the `not_cross_ref`
; the cross-ref half would have raised on its own. That is the union
; machinery's standing behaviour (per-branch causes are swallowed in favour
; of naming the alternatives) and applies here for the same reason it applies
; to a hand-written union.
(plugin :name gfx :version "1.0.0" :sjon "1.3"
  (value-kind :name bone-count :underlying number)
  (value-kind :name define-ref :underlying symbol
    :cross-ref (cross-ref :target define :name-key name))
  (value-kind :name bone-count-or-ref
    :underlying scalar-or-ref
    :scalar-or-ref (scalar-or-ref-shape :base bone-count :ref define-ref))
  (form :name define
    (key :name name :type symbol)
    (key :name value :type number))
  (form :name mesh
    (key :name bones :type bone-count-or-ref)))

(define :name MAX_BONES :value 128)

(mesh :bones MAX_BONES)   ; the ref half — resolves to the (define …)
(mesh :bones 128)         ; the base half — a plain number
(mesh :bones MAX_BONE)    ; neither — accepted silently before `:ref` existed
