; The reject side of `:multiple-of`, including the case that separates an
; exact implementation from a sloppy one.
;
; `9007199254740993` is 2^53 + 1 — odd, so not a multiple of 2. As an f64 it
; rounds to 2^53, which IS even, so an implementation that computes the
; remainder in floating point accepts it. Divisibility is decided in integer
; space whenever the value and the divisor are both whole, which is why this
; line must fail on every host.
;
; `3.5` reaches the divisibility check with no `:integer true` to catch it
; first: a fractional value under a whole divisor is never a multiple, and
; must not be rounded on the way in.
(plugin :name gfx :version "1.0.0"
  (value-kind :name aligned-offset
    :underlying number
    :numeric (numeric-bounds :multiple-of 256))

  (value-kind :name even
    :underlying number
    :numeric (numeric-bounds :multiple-of 2))

  (value-kind :name aligned-bytes
    :underlying number
    :unit    (unit-shape :required true :allowed [b])
    :numeric (numeric-bounds :multiple-of 256b))

  (form :name entry
    (key :name binding :type number)
    (key :name offset  :type aligned-offset :optional true)
    (key :name count   :type even           :optional true)
    (key :name span    :type aligned-bytes  :optional true)))

(entry :binding 0 :offset 250)
(entry :binding 1 :offset 3.5)
(entry :binding 2 :count 9007199254740993)
(entry :binding 3 :span 250b)
