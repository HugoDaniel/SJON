; The same `scalar-or-ref` slot also accepts a bare symbol — the `symbol`
; alternative of the desugared `union [count-value symbol]` matches it. This
; is the `#define`-style reference half of the shorthand.
(plugin :name refs :version "1.0.0"
  (value-kind :name count-value :underlying number)
  (value-kind :name count
    :underlying scalar-or-ref
    :scalar-or-ref (scalar-or-ref-shape :base count-value))
  (form :name use
    (key :name n :type count :optional false)))

(use :n MY_DEFINE)
