; `cross-ref-provider-resolved`'s manifest plus a scope opener. `:scope
; pass` is the same key the identity route takes (`cross-ref-lexical-
; scope-piece` pins that side); what this case checks is that it composes
; with the provider route rather than being an alternative to it.
(plugin :name lines :version "1.0.0" :sjon "1.2"
  (cross-ref-provider :name lines
    :description "One name per non-empty line."
    :impl "wasm:extract_lines")

  (form :name shader
    (key :name name :type symbol :optional false)
    (key :name src :type string :optional false))

  (value-kind :name uniform-name
    :underlying symbol
    :cross-ref (cross-ref :target shader :provider lines :scope pass))

  (form :name bind
    (key :name uniform :type uniform-name :optional false))

  (form :name pass
    :positional any))
