; Same manifest as `cross-ref-provider-resolved`. The refusal below is
; the provider's answer to a particular source, not a different schema.
(plugin :name lines :version "1.0.0"
  (cross-ref-provider :name lines
    :description "One name per non-empty line."
    :impl "wasm:extract_lines")

  (form :name shader
    (key :name name :type symbol :optional false)
    (key :name src :type string :optional false))

  (value-kind :name uniform-name
    :underlying symbol
    :cross-ref (cross-ref :target shader :provider lines))

  (form :name bind
    (key :name uniform :type uniform-name :optional false)))
