; `(key … :requires [b])` — presence implies presence, the third way a form
; relates its keys. `exclusive-group` bounds *how many* of a set may appear;
; `(variant …)` gates keys on another key's **value**; this gates one key's
; requirement on another key's *presence*.
;
; The WebGPU bind-group entry is the motivating shape: a byte `:offset` into
; no buffer describes nothing, so `:offset` and `:size` are meaningful only
; alongside `:buffer`.
;
; The accept side, including the case that shows the rule is one-directional:
; `:buffer` alone is fine. An absent dependent key constrains nothing, so
; only writing `:offset` turns the requirement on.
(plugin :name gfx :version "1.0.0"
  (value-kind :name byte-count :underlying number
    :numeric (numeric-bounds :min 0 :integer true))
  (value-kind :name buffer-ref :underlying symbol
    :cross-ref (cross-ref :target buffer))

  (form :name buffer
    (key :name name :type symbol :optional false))

  (form :name entry
    (key :name binding :type number     :optional false)
    (key :name buffer  :type buffer-ref :optional true)
    (key :name offset  :type byte-count :optional true :requires [buffer]
      :description "Byte offset into :buffer. Meaningless without it.")
    (key :name size    :type byte-count :optional true :requires [buffer]
      :description "Byte size of the bound range. Meaningless without :buffer.")))

(buffer :name uniforms)

(entry :binding 0 :buffer uniforms :offset 256 :size 64)  ; both satisfied
(entry :binding 1)                                        ; neither present
(entry :binding 2 :buffer uniforms)                       ; the requirement alone
