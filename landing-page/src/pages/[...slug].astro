---
// Lesson catch-all. Drives every URL listed in src/lib/lessons.ts —
// these used to live under /tutorial when TutorialKit owned the
// renderer, but the routes were already at the site root and we keep
// them that way (with a /tutorial → first-lesson redirect).

import { getCollection, render, type CollectionEntry } from 'astro:content';
import Lesson from '../layouts/Lesson.astro';
import { LESSONS, type Lesson as LessonInfo } from '../lib/lessons';
import { path } from '../lib/url';

export async function getStaticPaths() {
  const entries = await getCollection('tutorial');
  return LESSONS.map((lesson) => {
    const entry = entries.find((e) => e.id.startsWith(`${lesson.dir}/`));
    if (!entry) {
      throw new Error(
        `Missing tutorial entry for ${lesson.slug} — expected a content.md under ${lesson.dir}.`,
      );
    }
    return {
      params: { slug: lesson.route.replace(/^\//, '') },
      props: { lesson, entry },
    };
  });
}

interface Props {
  lesson: LessonInfo;
  entry: CollectionEntry<'tutorial'>;
}
const { lesson, entry } = Astro.props as Props;

const { Content } = await render(entry);
---

<Lesson title={lesson.title} current={lesson}>
    <article class="lesson-article">
        <header class="lesson-header">
            <p class="crumbs">
                <span>{lesson.part}</span>
                <span class="sep" aria-hidden="true">·</span>
                <span>{lesson.chapter}</span>
                <span class="sep" aria-hidden="true">·</span>
                <span class="num">Lesson {String(lesson.num).padStart(2, '0')}</span>
            </p>
            <h1>{lesson.title}</h1>
        </header>

        <div class="lesson-body">
            <Content />
        </div>

        <nav class="lesson-prev-next" aria-label="Lesson navigation">
            {lesson.num > 1 && (
                <a class="prev" href={path(LESSONS[lesson.num - 2]!.route)}>
                    <span class="dir">← Previous</span>
                    <span class="title">{LESSONS[lesson.num - 2]!.title}</span>
                </a>
            )}
            {lesson.num < LESSONS.length && (
                <a class="next" href={path(LESSONS[lesson.num]!.route)}>
                    <span class="dir">Next →</span>
                    <span class="title">{LESSONS[lesson.num]!.title}</span>
                </a>
            )}
        </nav>
    </article>
</Lesson>

<script src={path('/mastery-quiz.js')} is:inline></script>

<style>
    .lesson-article {
        max-width: var(--measure);
    }
    .lesson-header {
        margin-bottom: var(--space-4);
    }
    .crumbs {
        font-family: var(--mono);
        font-size: 0.78rem;
        color: var(--ink-soft);
        text-transform: lowercase;
        letter-spacing: 0.02em;
        margin-bottom: var(--space-2);
    }
    .crumbs .sep { margin: 0 6px; }
    .crumbs .num { font-style: normal; }

    .lesson-header h1 {
        font-size: var(--step-3);
        font-weight: 400;
        line-height: var(--leading-tight);
        margin: 0;
    }

    .lesson-body {
        margin-top: var(--space-4);
    }
    .lesson-body :global(h2) {
        font-size: var(--step-2);
        font-weight: 600;
        margin-top: var(--space-4);
        margin-bottom: var(--space-2);
    }
    .lesson-body :global(h3) {
        font-size: var(--step-1);
        font-weight: 600;
        margin-top: var(--space-3);
        margin-bottom: var(--space-1);
    }
    .lesson-body :global(p) {
        margin-top: 1em;
    }
    .lesson-body :global(ul),
    .lesson-body :global(ol) {
        margin: 1em 0 1em var(--space-3);
        padding-left: 1.2em;
    }
    .lesson-body :global(ul) { list-style: disc; }
    .lesson-body :global(ol) { list-style: decimal; }
    .lesson-body :global(li) { padding: 2px 0; }
    .lesson-body :global(strong) { font-weight: 600; }
    .lesson-body :global(em) { font-style: italic; }
    .lesson-body :global(a) {
        color: var(--ink);
        text-decoration-thickness: 0.5px;
        text-underline-offset: 3px;
    }
    .lesson-body :global(a:hover) { text-decoration-thickness: 1.5px; }
    .lesson-body :global(code) {
        font-family: var(--mono);
        font-size: 0.92em;
        background: var(--surface-mute);
        border: 1px solid var(--rule);
        padding: 0.1em 0.35em;
        border-radius: 3px;
    }
    .lesson-body :global(pre) {
        margin: var(--space-3) 0;
        padding: var(--space-3);
        background: var(--surface-mute) !important;
        border: 1px solid var(--rule);
        border-radius: 6px;
        overflow-x: auto;
    }
    .lesson-body :global(pre code) {
        background: transparent;
        border: 0;
        padding: 0;
        font-size: 14px;
        line-height: 1.5;
    }
    .lesson-body :global(blockquote) {
        margin: var(--space-3) 0;
        padding-left: var(--space-3);
        border-left: 0.5px solid var(--rule);
        color: var(--ink-soft);
    }
    .lesson-body :global(hr) {
        margin: var(--space-4) 0;
        border: 0;
        border-top: 0.5px solid var(--rule);
    }
    .lesson-body :global(table) {
        border-collapse: collapse;
        margin: var(--space-3) 0;
        font-size: 0.95rem;
    }
    .lesson-body :global(th),
    .lesson-body :global(td) {
        text-align: left;
        padding: 6px 12px 6px 0;
        border-bottom: 0.5px solid var(--rule);
        vertical-align: top;
    }

    /* Mastery quiz — rendered as raw HTML inside lesson markdown. */
    .lesson-body :global(.mastery-quiz) {
        margin: var(--space-4) 0;
        border-top: 0.5px solid var(--rule);
        border-bottom: 0.5px solid var(--rule);
        padding: var(--space-3) 0;
    }
    .lesson-body :global(.mastery-quiz > h2) {
        margin: 0 0 var(--space-2);
        font-size: var(--step-2);
        font-weight: 600;
    }
    .lesson-body :global(.mastery-quiz .mc-list) {
        margin: var(--space-2) 0 0;
        padding: 0;
        list-style: none;
        counter-reset: mc;
    }
    .lesson-body :global(.mastery-quiz .mc-item) {
        margin-top: var(--space-3);
        padding-top: var(--space-3);
        border-top: 0.5px solid var(--rule);
        counter-increment: mc;
    }
    .lesson-body :global(.mastery-quiz .mc-item:first-child) {
        border-top: 0;
        padding-top: 0;
        margin-top: 0;
    }
    .lesson-body :global(.mastery-quiz .mc-q) {
        margin: 0 0 var(--space-2);
        font-weight: 600;
    }
    .lesson-body :global(.mastery-quiz .mc-q::before) {
        content: counter(mc) '. ';
        color: var(--ink-soft);
        font-family: var(--mono);
        font-weight: 400;
        margin-right: 4px;
    }
    .lesson-body :global(.mastery-quiz .mc-options) {
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .lesson-body :global(.mastery-quiz .mc-options li) {
        padding: 3px 0;
    }
    .lesson-body :global(.mastery-quiz .mc-options label) {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        cursor: pointer;
        line-height: 1.5;
    }
    .lesson-body :global(.mastery-quiz .mc-options input[type='radio']) {
        appearance: auto;
        -webkit-appearance: auto;
        -moz-appearance: auto;
        position: static;
        opacity: 1;
        flex: 0 0 auto;
        width: auto;
        height: auto;
        margin-top: 6px;
        padding: 0;
        border: initial;
        accent-color: var(--ink);
        cursor: pointer;
    }
    .lesson-body :global(.mastery-quiz .mc-feedback) {
        margin: var(--space-2) 0 0;
        font-size: 0.92rem;
        font-style: italic;
        color: var(--ink-soft);
    }
    .lesson-body :global(.mastery-quiz .mc-item.is-correct .mc-feedback) {
        color: var(--correct);
    }
    .lesson-body :global(.mastery-quiz .mc-item.is-wrong .mc-feedback) {
        color: var(--wrong);
    }
    .lesson-body :global(.mastery-quiz .mc-item.is-correct .mc-feedback::before) {
        content: '✓ ';
        font-style: normal;
    }
    .lesson-body :global(.mastery-quiz .mc-item.is-wrong .mc-feedback::before) {
        content: '✗ ';
        font-style: normal;
    }
    .lesson-body :global(.mastery-quiz .mc-options li.is-answer label) {
        font-weight: 600;
        color: var(--correct);
    }
    .lesson-body :global(.mastery-quiz .mc-options li.is-answer input[type='radio']) {
        accent-color: var(--correct);
    }
    .lesson-body :global(.mastery-quiz .mc-options li.is-answer label::after) {
        content: ' — correct answer';
        color: var(--correct);
        font-weight: 400;
        font-style: italic;
        font-size: 0.88em;
    }
    /* The option the reader picked, when it wasn't the correct one. */
    .lesson-body :global(.mastery-quiz .mc-options li.is-picked:not(.is-answer) label) {
        color: var(--wrong);
    }
    .lesson-body :global(.mastery-quiz .mc-options li.is-picked:not(.is-answer) input[type='radio']) {
        accent-color: var(--wrong);
    }
    .lesson-body :global(.mastery-quiz .mc-options li.is-picked:not(.is-answer) label::after) {
        content: ' — your answer';
        color: var(--wrong);
        font-weight: 400;
        font-style: italic;
        font-size: 0.88em;
    }
    .lesson-body :global(.mastery-quiz .mc-explanation) {
        margin: 4px 0 0 1.6em;
        font-size: 0.88rem;
        color: var(--ink-soft);
        line-height: 1.5;
        border-left: 2px solid var(--rule-mute);
        padding-left: var(--space-2);
    }
    .lesson-body :global(.mastery-quiz .mc-options li.is-answer .mc-explanation) {
        border-left-color: var(--correct);
        color: var(--ink);
    }
    .lesson-body :global(.mastery-quiz .mc-controls) {
        margin-top: var(--space-3);
        display: flex;
        gap: var(--space-3);
        align-items: center;
        flex-wrap: wrap;
    }
    .lesson-body :global(.mastery-quiz button) {
        font-family: var(--serif);
        font-size: 1rem;
        background: var(--ink);
        color: var(--paper);
        border: none;
        padding: 8px 18px;
        cursor: pointer;
    }
    .lesson-body :global(.mastery-quiz button.mc-reset) {
        background: transparent;
        color: var(--ink);
        border: 0.5px solid var(--rule);
    }
    .lesson-body :global(.mastery-quiz button:hover) {
        background: color-mix(in oklch, var(--ink) 90%, var(--paper));
    }
    .lesson-body :global(.mastery-quiz button.mc-reset:hover) {
        background: color-mix(in oklch, var(--paper) 92%, var(--ink));
    }
    .lesson-body :global(.mastery-quiz .mc-score) {
        margin: 0;
        font-family: var(--mono);
        font-size: 0.95rem;
    }

    /* Diagnostics lesson sticky codes table — wrapped at migration time. */
    .lesson-body :global(.codes-sticky) {
        position: sticky;
        top: 8px;
        max-height: calc(100vh - 120px);
        overflow-y: auto;
        background: color-mix(in oklch, var(--paper) 98%, var(--ink));
        border: 0.5px solid var(--rule);
        padding: 12px 16px;
        margin: var(--space-3) 0 var(--space-4);
        z-index: 1;
        font-size: 14px;
        line-height: 1.45;
    }
    .lesson-body :global(.codes-sticky table) { width: 100%; }
    .lesson-body :global(.codes-sticky tr:last-child td) { border-bottom: 0; }

    .lesson-prev-next {
        margin-top: var(--space-5);
        padding-top: var(--space-3);
        border-top: 0.5px solid var(--rule);
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-3);
    }
    .lesson-prev-next a {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: var(--space-2) var(--space-3);
        text-decoration: none;
        border: 0.5px solid var(--rule);
    }
    .lesson-prev-next a:hover {
        background: color-mix(in oklch, var(--paper) 94%, var(--ink));
    }
    .lesson-prev-next .next { text-align: right; grid-column: 2; }
    .lesson-prev-next .prev { grid-column: 1; }
    .lesson-prev-next .dir {
        font-family: var(--mono);
        font-size: 0.78rem;
        color: var(--ink-soft);
    }
</style>
