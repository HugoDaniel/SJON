---
import Marketing from '../layouts/Marketing.astro';

const jsonRows = [
  {
    area: 'Surface',
    json: 'Objects, arrays, strings, numbers, booleans, and null.',
    sjon: 'Forms, vectors, symbols, keywords, strings, booleans, nil, dates, times, and unit-bearing numbers.',
  },
  {
    area: 'Comments',
    json: 'No comments in standard RFC 8259 JSON.',
    sjon: 'Comments are captured as AST trivia. Preserved in lossless binary and printer paths, but discarded in canonical JSON/text.',
  },
  {
    area: 'Commas',
    json: 'Commas are required separators. Trailing commas are rejected in standard JSON.',
    sjon: 'Collections are whitespace-separated. Commas are illegal characters (invalid tokens) that raise syntax errors.',
  },
  {
    area: 'Keys',
    json: 'Object keys are strings. Duplicate-key behavior depends on parser and is often lossy/undefined.',
    sjon: 'Keys are :keyword-value pairs and are preserved in source order. Repeated keys are retained in the AST and flagged by schema validation.',
  },
  {
    area: 'Numbers',
    json: 'Stored as double-precision values, losing precision for large integers (> 2^53 - 1).',
    sjon: 'Integer literals stay exact up to 64-bit limits in the AST, but inline expression evaluation and some codecs cast them to f64.',
  },
  {
    area: 'Schema',
    json: 'No built-in schema layer; relies on external specifications (e.g., JSON Schema).',
    sjon: 'Validation is a core schema pass over the AST, with plugin-defined forms, slots, value kinds, and diagnostic spans.',
  },
  {
    area: 'Interop',
    json: 'Native serialization standard.',
    sjon: 'Semantic JSON bridge available. Canonical JSON normalizes form fields, discarding source order and trivia.',
  },
];

const ednRows = [
  {
    area: 'Data model',
    edn: 'Lists, vectors, maps, sets, symbols, keywords, and tagged literals.',
    sjon: 'Forms and vectors. No maps, sets, or lists. Forms use greedy :keyword pairing to represent key-value fields structurally.',
  },
  {
    area: 'Reader tags',
    edn: 'Extensible via custom reader tags (`#my/tag value`), requiring reader configuration.',
    sjon: 'Syntax-closed. No reader tags or syntax extensions. All domain semantics are resolved at the schema validation layer.',
  },
  {
    area: 'Computation',
    edn: 'Pure data representation; no built-in expression evaluation.',
    sjon: 'Includes a sandboxed, pure, and bounded interpreter (`evalExpr`) for safe inline calculations.',
  },
  {
    area: 'Strings',
    edn: 'Double-quoted strings with standard backslash escapes.',
    sjon: 'Double-quoted strings plus raw triple-double-quoted strings (`"""…"""`) for literal payloads.',
  },
  {
    area: 'Numbers',
    edn: 'Arbitrary precision numbers depend on reader and host platform support.',
    sjon: 'Integer literals are bounded to exact i64/u64; all other numeric paths default to f64.',
  },
  {
    area: 'Schema',
    edn: 'Requires external validation frameworks (e.g., Clojure Spec).',
    sjon: 'Integrated schema and validator are first-class layers separate from bare parsing.',
  },
  {
    area: 'Host support',
    edn: 'Mature and deeply integrated in Clojure; ecosystem support is highly uneven elsewhere.',
    sjon: 'Currently project-specific: Zig core with native host bindings for Node, Web, Rust, and TypeScript.',
  },
];

const caveats = [
  'Integer literals (without decimals or exponents) are stored as exact 64-bit integers (i64/u64) when within bounds.',
  'Float-shaped literals and unit-bearing numbers (e.g., 4b, 90deg) use standard IEEE-754 f64 values.',
  'Inline expressions (e.g., (* 2 x)) and the plugin value codec cast exact integers to f64 during evaluation.',
];
---

<Marketing
    title="SJON compared with JSON and EDN"
    description="A practical comparison of SJON, JSON, and EDN across syntax, comments, schemas, exact integers, reader behavior, and host tooling."
>
    <section class="compare-hero card card--main" aria-labelledby="compare-title">
        <div class="card__deck">
            <div class="card__panel compare-hero__panel">
                <p class="kicker">comparison</p>
                <h1 id="compare-title">SJON next to <abbr title="JavaScript Object Notation">JSON</abbr> and <abbr title="Extensible Data Notation">EDN</abbr></h1>
                <p>
                    SJON was designed for complex application state that is awkward to represent in JSON:
                    hierarchically structured documents, nested configurations with inline expressions, and
                    human-authored schemas that require rich syntax validation.
                </p>
                <p>
                    While JSON is the universal interchange format and EDN provides symbolic syntax, SJON
                    is designed as an integrated substrate. It incorporates the layers that host applications
                    typically have to implement on top of raw data: schema validation, comment-preserving
                    round-trips, pure inline expressions, and a high-performance binary format.
                </p>
            </div>
        </div>
    </section>

    <section class="compare-section" aria-labelledby="json-title">
        <p class="kicker">/01 - JSON</p>
        <h2 id="json-title">SJON vs JSON</h2>
        <p class="lede">
            JSON is optimized for machine-to-machine serialization. SJON is optimized for human-authored
            data files that require comments, structural validation, clear diagnostic errors, and
            domain-specific schemas.
        </p>
        <div class="comparison-table card">
            <table>
                <caption class="sr-only">Feature comparison between JSON and SJON.</caption>
                <thead>
                    <tr>
                        <th scope="col">Area</th>
                        <th scope="col">JSON</th>
                        <th scope="col">SJON</th>
                    </tr>
                </thead>
                <tbody>
                    {jsonRows.map((row) => (
                        <tr>
                            <th scope="row">{row.area}</th>
                            <td data-label="JSON" set:html={row.json}></td>
                            <td data-label="SJON" set:html={row.sjon}></td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </section>

    <section class="compare-section" aria-labelledby="edn-title">
        <p class="kicker">/02 - EDN</p>
        <h2 id="edn-title">SJON vs EDN</h2>
        <p class="lede">
            EDN shares SJON's emphasis on Lisp-like symbols and keywords. However, SJON differs in extensibility
            and execution: instead of arbitrary reader tags, SJON features a strict, non-extensible syntax reader.
            Domain-specific extensions are handled entirely at the schema and validation layers, while safe
            expression evaluation is handled via a sandboxed interpreter.
        </p>
        <div class="comparison-table card">
            <table>
                <caption class="sr-only">Feature comparison between EDN and SJON.</caption>
                <thead>
                    <tr>
                        <th scope="col">Area</th>
                        <th scope="col">EDN</th>
                        <th scope="col">SJON</th>
                    </tr>
                </thead>
                <tbody>
                    {ednRows.map((row) => (
                        <tr>
                            <th scope="row">{row.area}</th>
                            <td data-label="EDN" set:html={row.edn}></td>
                            <td data-label="SJON" set:html={row.sjon}></td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </section>

    <section class="compare-section caveats" aria-labelledby="numeric-title">
        <p class="kicker">/03 - numeric caveats</p>
        <h2 id="numeric-title">Where exactness has limits</h2>
        <p class="lede">
            SJON supports exact 64-bit integers (i64/u64) in the parser and AST. However, float-shaped and
            unit-bearing numbers use double-precision floating-point (f64). Downstream expression evaluation
            and some plugin codecs also cast numbers to f64. The exact guarantees are detailed below.
        </p>
        <ul class="caveat-list card card--main">
            {caveats.map((item) => <li set:html={item}></li>)}
        </ul>
    </section>

    <section class="compare-section closing" aria-labelledby="choose-title">
        <p class="kicker">/04 - choosing</p>
        <h2 id="choose-title">Which one to pick</h2>
        <p class="lede">
            These three formats overlap in surface and diverge in intent. The right choice follows the job
            in front of you, not a feature count.
        </p>
        <div class="choice-grid">
            <article class="card card--main">
                <div class="card__deck">
                    <div class="card__panel choice-panel">
                        <h3>Reach for JSON when</h3>
                        <p>
                            Universal interoperability and standard ecosystem libraries are the primary
                            requirement, and you don't need comments, custom validation, or symbolic data types.
                        </p>
                    </div>
                </div>
            </article>
            <article class="card card--main">
                <div class="card__deck">
                    <div class="card__panel choice-panel">
                        <h3>Reach for EDN when</h3>
                        <p>
                            You are working in a Clojure or Lisp ecosystem where native data structures
                            like maps, sets, and custom reader tags are first-class citizens.
                        </p>
                    </div>
                </div>
            </article>
            <article class="card card--main">
                <div class="card__deck">
                    <div class="card__panel choice-panel">
                        <h3>Reach for SJON when</h3>
                        <p>
                            You are building tooling or configurations where human authors need robust
                            schema validation with exact diagnostic spans, inline safe expressions,
                            comment-preserving round-trips, and optional compact binary serialization.
                        </p>
                    </div>
                </div>
            </article>
        </div>
    </section>
</Marketing>

<style>
    .compare-hero,
    .compare-section {
        max-width: 980px;
        margin: var(--space-5) auto;
    }
    .compare-hero__panel {
        padding: calc(var(--card-stripes-h) + var(--space-4)) var(--space-5) var(--space-5);
    }
    .compare-hero h1 {
        font-size: var(--step-3);
        letter-spacing: 0;
        margin-bottom: var(--space-3);
    }
    .compare-hero p,
    .compare-section .lede {
        max-width: 66ch;
        color: var(--ink-soft);
        line-height: var(--leading-body);
    }
    .compare-hero p + p {
        margin-top: 0.85em;
    }
    .compare-section {
        padding: 0 var(--space-3);
    }
    .compare-section h2 {
        font-size: var(--step-2);
        letter-spacing: 0;
        margin-bottom: var(--space-2);
    }
    .comparison-table {
        margin-top: var(--space-3);
        overflow-x: auto;
    }
    .comparison-table table {
        width: 100%;
        border-collapse: collapse;
        background: var(--surface);
        min-width: 760px;
    }
    .comparison-table th,
    .comparison-table td {
        vertical-align: top;
        text-align: left;
        border-bottom: 1px solid var(--rule-mute);
        padding: 13px 16px;
        line-height: 1.45;
    }
    .comparison-table thead th {
        font-family: var(--mono);
        font-size: 12px;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        background: var(--surface-mute);
    }
    .comparison-table tbody th {
        width: 9rem;
        font-weight: 600;
        color: var(--ink);
    }
    .comparison-table td {
        color: var(--ink-soft);
    }
    .comparison-table tr:last-child th,
    .comparison-table tr:last-child td {
        border-bottom: 0;
    }
    .caveat-list {
        margin: var(--space-3) 0 0;
        padding: calc(var(--card-stripes-h) + var(--space-3)) var(--space-4) var(--space-4);
        list-style: none;
    }
    .caveat-list li {
        position: relative;
        padding-left: 18px;
        color: var(--ink-soft);
        line-height: 1.55;
    }
    .caveat-list li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.72em;
        width: 7px;
        height: 7px;
        border: 1px solid var(--ink);
        background: var(--accent);
        border-radius: 2px;
    }
    .caveat-list li + li {
        margin-top: var(--space-2);
    }
    .choice-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--space-3);
        margin-top: var(--space-3);
    }
    .choice-panel {
        padding: calc(var(--card-stripes-h) + var(--space-3)) var(--space-3) var(--space-3);
    }
    .choice-panel h3 {
        font-size: 18px;
        letter-spacing: 0;
        margin-bottom: var(--space-2);
    }
    .choice-panel p {
        color: var(--ink-soft);
        line-height: 1.5;
    }

    @media (max-width: 800px) {
        .choice-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 600px) {
        .compare-hero__panel {
            padding: calc(var(--card-stripes-h) + var(--space-3)) var(--space-4) var(--space-4);
        }
        .compare-hero h1 {
            font-size: 30px;
        }
        .comparison-table {
            overflow-x: visible;
        }
        .comparison-table table,
        .comparison-table thead,
        .comparison-table tbody,
        .comparison-table tr,
        .comparison-table th,
        .comparison-table td {
            display: block;
            min-width: 0;
            width: 100%;
        }
        .comparison-table thead {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip: rect(0 0 0 0);
            white-space: nowrap;
        }
        .comparison-table tbody tr {
            padding: var(--space-3);
            border-bottom: 1px solid var(--rule-mute);
        }
        .comparison-table tbody tr:last-child {
            border-bottom: 0;
        }
        .comparison-table th,
        .comparison-table td {
            border-bottom: 0;
            padding: 0;
        }
        .comparison-table tbody th {
            width: 100%;
            margin-bottom: var(--space-2);
        }
        .comparison-table td {
            display: grid;
            grid-template-columns: 4.5rem 1fr;
            gap: var(--space-2);
        }
        .comparison-table td + td {
            margin-top: var(--space-2);
        }
        .comparison-table td::before {
            content: attr(data-label);
            font-family: var(--mono);
            font-size: 12px;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
    }
</style>
