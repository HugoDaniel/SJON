---
import Marketing from '../layouts/Marketing.astro';
import { PLAYGROUND_EXAMPLES } from '../playground/examples';
import '../styles/playground.css';
---

<Marketing
  title="SJON Playground"
  description="Write SJON in your browser. Parses, validates, and evaluates as you type — nothing leaves the tab."
>
  <section class="playground">
    <p class="kicker">/ playground</p>
    <h1>Try SJON in your browser.</h1>
    <p class="lede">
      Type below. The parser, validator, and expression evaluator all run
      locally in your tab — diagnostics show up in the gutter, and every
      expression's value shows up under the editor, as you go.
    </p>
    <div class="editor-frame">
      <div class="pg-stale" data-pg-stale hidden>
        <strong>LSP assets out of date.</strong> The running language server disagrees
        with the last build — run <code>zig build landing-page-assets</code> to refresh it.
      </div>
      <!-- Unhidden by `showLspFailure` (src/playground/lsp-failure.ts) when the
           language server fails to boot on both backends. Without it the page
           looks healthy and every server-fed panel is silently empty forever.
           `lsp-failure.test.ts` asserts both hooks below still exist here. -->
      <div class="pg-failed" data-pg-lsp-failed hidden role="alert">
        <strong>Language server failed to load.</strong> Diagnostics, the outline,
        and evaluated values are unavailable — editing, examples, and highlighting
        still work. <code data-pg-lsp-failed-reason></code>
      </div>
      <div class="pg-tabs">
        <div class="pg-tablist" role="tablist" aria-label="Playground panes" data-pg-tablist>
          <div
            class="pg-tab"
            role="tab"
            id="pg-tab-document"
            aria-selected="true"
            aria-controls="pg-pane-document"
            tabindex="0"
            data-pg-tab="document"
          >
            <span class="pg-tab__label">document</span>
          </div>
        </div>
        <button class="pg-tab--add" type="button" data-pg-add aria-label="Add a schema">
          + schema
        </button>
        <label class="pg-examples">
          <span class="sr-only">Load an example</span>
          <select class="pg-examples__select" data-pg-examples>
            {/* Placeholder for a document the visitor edited or arrived at
                through a share link. Hidden from the open list, but it is
                what the closed picker reads once an example stops matching. */}
            <option value="" hidden>Custom</option>
            {PLAYGROUND_EXAMPLES.map((example) => (
              <option value={example.id} title={example.blurb}>{example.title}</option>
            ))}
          </select>
        </label>
        <button
          class="pg-copy-link"
          type="button"
          data-pg-outline-toggle
          aria-expanded="false"
          aria-controls="pg-outline">Outline</button>
        <button class="pg-copy-link" type="button" data-pg-format>Format</button>
        <button class="pg-copy-link" type="button" data-pg-copy>Copy link</button>
      </div>
      <div class="pg-body">
        <div class="pg-panes" data-pg-panes>
          <div
            class="pg-pane"
            id="pg-pane-document"
            role="tabpanel"
            aria-labelledby="pg-tab-document"
            data-pg-pane="document"
          >
            <div id="sjon-editor"></div>
          </div>
        </div>
        <aside class="pg-outline" id="pg-outline" data-pg-outline hidden>
          <p class="pg-outline__title">outline</p>
          <nav class="pg-outline__rows" data-pg-outline-rows aria-label="Document outline"></nav>
        </aside>
      </div>
      <section class="pg-eval" data-pg-eval>
        <p class="pg-eval__title">values</p>
        <div class="pg-eval__rows" data-pg-eval-rows aria-live="polite"></div>
      </section>
    </div>
  </section>
</Marketing>

<script>
  import { mountPlayground } from '../playground/boot';
  const host = document.getElementById('sjon-editor');
  if (host) mountPlayground(host);
</script>
