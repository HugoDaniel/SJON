---
// One page per diagnostic code. These are the targets of the LSP's
// `codeDescription.href`, so every code in the wire-stable enum needs a
// route here — which is why the catalogue is generated rather than
// hand-kept (`zig build gen-explanations`).

import Marketing from '../../layouts/Marketing.astro';
import { ERRORS, type ErrorEntry, inlineMarkup, paragraphs } from '../../lib/errors';
import { path } from '../../lib/url';

export function getStaticPaths() {
  return ERRORS.map((entry) => ({
    params: { code: entry.code },
    props: { entry },
  }));
}

interface Props {
  entry: ErrorEntry;
}
const { entry } = Astro.props as Props;

const body = paragraphs(entry.long);

// Neighbours in catalogue order, which is the enum's declaration order —
// related codes were appended together, so this lands the reader next to
// the ones they are most likely to hit in the same session.
const index = ERRORS.findIndex((e) => e.code === entry.code);
const prev = index > 0 ? ERRORS[index - 1] : undefined;
const next = index < ERRORS.length - 1 ? ERRORS[index + 1] : undefined;
---

<Marketing
    title={`${entry.code} — SJON diagnostics`}
    description={entry.short}
>
    <article class="error-page">
        <p class="kicker">
            <a href={path('/errors')}>diagnostics</a>
        </p>
        <h1><code>{entry.code}</code></h1>
        <p class="lede" set:html={inlineMarkup(entry.short)}></p>

        {body.length > 0 && (
            <div class="error-body">
                {body.map((para) => <p set:html={inlineMarkup(para)}></p>)}
            </div>
        )}

        <nav class="error-nav" aria-label="Nearby codes">
            {prev && (
                <a class="prev" href={path(`/errors/${prev.code}`)}>
                    <span class="dir">← Previous</span>
                    <span class="name">{prev.code}</span>
                </a>
            )}
            {next && (
                <a class="next" href={path(`/errors/${next.code}`)}>
                    <span class="dir">Next →</span>
                    <span class="name">{next.code}</span>
                </a>
            )}
        </nav>
    </article>
</Marketing>

<style>
    .error-page {
        max-width: 68ch;
        margin: var(--space-5) auto;
        padding: 0 var(--space-4);
    }
    .error-page h1 {
        margin: var(--space-2) 0 var(--space-3);
        font-size: var(--step-2);
        font-weight: 400;
        line-height: var(--leading-tight);
    }
    .error-page h1 code {
        font-family: var(--mono);
        font-size: 0.95em;
    }
    .error-page .kicker a {
        color: inherit;
        text-decoration: none;
        border-bottom: 1px solid currentColor;
    }
    .error-page .lede {
        font-size: var(--step-1);
        line-height: var(--leading-body);
    }
    .error-body {
        margin-top: var(--space-4);
    }
    .error-body p {
        margin-top: 1em;
        line-height: var(--leading-body);
    }
    .error-page code {
        font-family: var(--mono);
        font-size: 0.92em;
        background: var(--surface-mute);
        padding: 0.1em 0.35em;
        border-radius: 3px;
    }
    .error-page h1 code {
        background: none;
        padding: 0;
    }

    .error-nav {
        margin-top: var(--space-5);
        padding-top: var(--space-3);
        border-top: 1px solid var(--rule-mute);
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-3);
    }
    .error-nav a {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: var(--space-2) var(--space-3);
        text-decoration: none;
        color: inherit;
        border: 1px solid var(--rule-mute);
    }
    .error-nav .next { text-align: right; grid-column: 2; }
    .error-nav .prev { grid-column: 1; }
    .error-nav .dir {
        font-family: var(--mono);
        font-size: 0.78rem;
        opacity: 0.7;
    }
    .error-nav .name { font-family: var(--mono); }
</style>
