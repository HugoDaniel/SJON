---
// Catalogue index — every diagnostic code with its one-line summary.
// Order is the enum's, which is also the order codes were added, so the
// oldest and most commonly hit codes sit at the top.

import Marketing from '../../layouts/Marketing.astro';
import { ERRORS, inlineMarkup } from '../../lib/errors';
import { path } from '../../lib/url';
---

<Marketing
    title="SJON diagnostics"
    description="Every SJON diagnostic code, with what it means and how to repair it."
>
    <article class="errors-index">
        <p class="kicker">diagnostics</p>
        <h1>Diagnostic codes</h1>
        <p class="lede">
            Every code SJON can emit. The set is wire-stable — codes are appended, never
            renamed or renumbered — so a code you handle today keeps meaning the same thing.
            Editors link here from the diagnostic itself.
        </p>

        <ul class="code-list">
            {ERRORS.map((entry) => (
                <li>
                    <a href={path(`/errors/${entry.code}`)}><code>{entry.code}</code></a>
                    <span class="summary" set:html={inlineMarkup(entry.short)}></span>
                </li>
            ))}
        </ul>
    </article>
</Marketing>

<style>
    .errors-index {
        max-width: 80ch;
        margin: var(--space-5) auto;
        padding: 0 var(--space-4);
    }
    .errors-index h1 {
        margin: var(--space-2) 0 var(--space-3);
        font-size: var(--step-2);
        font-weight: 400;
    }
    .errors-index .lede {
        max-width: 68ch;
        line-height: var(--leading-body);
    }
    .code-list {
        margin: var(--space-4) 0 0;
        padding: 0;
        list-style: none;
    }
    /* Stacked rather than a two-column table: code names run to 40
     * characters (`multiple_defaulted_alternatives_in_group`), so a
     * shared column sized to the longest would strand every short name
     * beside a wall of whitespace. */
    .code-list li {
        padding: var(--space-2) 0;
        border-bottom: 1px solid var(--rule-mute);
    }
    .code-list a {
        color: inherit;
        text-decoration: none;
    }
    .code-list a:hover { text-decoration: underline; }
    .code-list code {
        font-family: var(--mono);
        font-size: 0.92em;
    }
    .code-list .summary {
        display: block;
        margin-top: 2px;
        line-height: var(--leading-body);
        opacity: 0.8;
    }
    .code-list :global(code) {
        font-family: var(--mono);
        font-size: 0.92em;
    }
</style>
