---
// Lesson layout — same marketing shell as the landing/comparison pages,
// with a tutorial sidebar and a single readable content column.

import '../styles/system-tokens.css';
import { groupedLessons, FIRST_LESSON, type Lesson } from '../lib/lessons';
import { path } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** The lesson currently being rendered, used to highlight the sidebar. */
  current?: Lesson;
}

const {
  title,
  description = 'SJON tutorial: syntax, schemas, safe expressions, and diagnostics.',
  current,
} = Astro.props;
const groups = groupedLessons();
const pageTitle = `${title} · SJON Tutorial`;
const navItems = [
  { href: '/compare', label: 'Compare' },
  { href: '/playground', label: 'Playground' },
  { href: FIRST_LESSON.route, label: 'Tutorial' },
  { href: 'https://git.hugodaniel.com/releases/sjon', label: 'Source', external: true },
];
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={path('/favicon.svg')} />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <nav class="topbar" aria-label="Site">
        <a class="brand" href={path('/')}>
            <span class="brand-mark" aria-hidden="true"></span>
            <span class="brand-name">sjon</span>
        </a>
        <ul class="nav">
            {navItems.map((item) => (
                <li>
                    <a
                        href={item.external ? item.href : path(item.href)}
                        aria-current={item.href === FIRST_LESSON.route ? 'page' : undefined}
                        rel={item.external ? 'external' : undefined}
                    >
                        {item.label}
                    </a>
                </li>
            ))}
        </ul>
        <span class="version" aria-hidden="true">v1.0.0</span>
    </nav>

    <div class="lesson-shell">
        <div class="lesson-tools">
            <button class="sidebar-toggle" type="button" aria-expanded="false" aria-controls="lesson-sidebar">
                <span aria-hidden="true">≡ </span>Lessons
            </button>
        </div>

        <aside class="lesson-sidebar" id="lesson-sidebar">
            <nav aria-label="Tutorial lessons">
                {groups.map((p) => (
                    <section class="part">
                        <h2>{p.part}</h2>
                        {p.chapters.map((c) => (
                            <div class="chapter">
                                <h3>{c.chapter}</h3>
                                <ol>
                                    {c.lessons.map((l) => (
                                        <li class:list={["lesson-link", current?.slug === l.slug && "is-current"]}>
                                            <a href={path(l.route)} aria-current={current?.slug === l.slug ? 'page' : undefined}>
                                                <span class="num">{String(l.num).padStart(2, '0')}</span>
                                                <span class="title">{l.title}</span>
                                            </a>
                                        </li>
                                    ))}
                                </ol>
                            </div>
                        ))}
                    </section>
                ))}
            </nav>
        </aside>

        <main id="main-content" class="lesson-main card card--main" tabindex="-1">
            <div class="card__deck">
                <div class="card__panel lesson-panel">
                    <slot />
                </div>
            </div>
        </main>
    </div>

    <footer class="site-footer">
        <p>SJON 1.0: stable language, documented plainly.</p>
        <p class="muted">v1.0.0 · <abbr title="Creative Commons Zero 1.0 Universal">CC0-1.0</abbr> · <a href="https://git.hugodaniel.com/releases/sjon" rel="external">git.hugodaniel.com/releases/sjon</a></p>
    </footer>

    <script is:inline>
        (function () {
            const sideBtn = document.querySelector('.sidebar-toggle');
            const aside = document.getElementById('lesson-sidebar');
            if (sideBtn && aside) {
                sideBtn.addEventListener('click', () => {
                    const open = aside.classList.toggle('is-open');
                    sideBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
                });
            }
        })();
    </script>
</body>
</html>

<style>
    :global(:root) {
        --rule: var(--rule-mute);
    }

    .topbar {
        position: sticky;
        top: 0;
        z-index: 10;
        height: var(--topbar-height);
        padding: 0 var(--space-4);
        display: flex;
        align-items: center;
        gap: var(--space-4);
        background: rgba(237, 230, 227, 0.92);
        backdrop-filter: saturate(180%) blur(8px);
        -webkit-backdrop-filter: saturate(180%) blur(8px);
        border-bottom: 1px solid var(--ink);
        font-family: var(--body);
        font-size: 14px;
    }
    .brand {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: var(--ink);
        font-family: var(--display);
        font-size: 15px;
        letter-spacing: 0;
    }
    .brand:hover { color: var(--ink); }
    .brand:hover .brand-mark { background: var(--accent-cool); }
    .brand-mark {
        display: inline-block;
        width: 12px;
        height: 12px;
        background: var(--accent);
        border: 1px solid var(--ink);
        border-radius: 3px;
        transition: background 0.15s ease;
    }
    .brand-name { line-height: 1; }

    .nav {
        display: flex;
        gap: var(--space-3);
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .nav a {
        text-decoration: none;
        color: var(--ink);
        font-family: var(--body);
        font-weight: 500;
        font-size: 14px;
        padding: 4px 8px;
        border-radius: 4px;
    }
    .nav a:hover {
        color: var(--accent);
        background: rgba(240, 100, 73, 0.10);
    }
    .nav a[aria-current="page"] {
        color: var(--ink);
        background: var(--surface);
    }
    .version {
        margin-left: auto;
        font-family: var(--mono);
        font-size: 12px;
        color: var(--ink-soft);
        padding: 2px 8px;
        border: 1px solid var(--rule-mute);
        border-radius: var(--radius-pill);
    }

    .lesson-tools {
        display: none;
    }

    .lesson-shell {
        display: grid;
        grid-template-columns: 280px minmax(0, 1fr);
        gap: var(--space-4);
        max-width: 1120px;
        margin: 0 auto;
        padding: var(--space-5) var(--space-4);
    }

    .sidebar-toggle {
        background: var(--surface);
        border: 1px solid var(--ink);
        border-radius: var(--radius-card);
        box-shadow: 3px 3px 0 var(--shadow);
        color: var(--ink);
        font-family: var(--body);
        font-size: 15px;
        font-weight: 600;
        padding: 9px 14px;
        cursor: pointer;
    }
    .lesson-sidebar {
        --card-stripes-h: 22px;
        position: sticky;
        top: calc(var(--topbar-height) + var(--space-3));
        align-self: start;
        max-height: calc(100vh - var(--topbar-height) - var(--space-4));
        overflow-y: auto;
        font-size: 14px;
        line-height: 1.4;
        padding: calc(var(--card-stripes-h) + var(--space-3)) var(--space-3) var(--space-3);
        background-color: var(--surface);
        border: 1px solid var(--ink);
        border-radius: var(--radius-card);
        box-shadow: 5px 5px 0 var(--shadow);
        --stripe-1: var(--ink);
        --stripe-2: var(--ink);
        --stripe-3: var(--ink);
        background-image: linear-gradient(
            to bottom,
            transparent 0 4px,
            var(--stripe-1) 4px 6px,
            transparent 6px 10px,
            var(--stripe-2) 10px 12px,
            transparent 12px 16px,
            var(--stripe-3) 16px 18px,
            transparent 18px 22px
        );
        background-repeat: no-repeat;
        background-size: 100% var(--card-stripes-h);
    }
    .lesson-sidebar h2 {
        font-family: var(--display);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: var(--accent);
        margin: var(--space-3) 0 var(--space-2);
    }
    .lesson-sidebar .part:first-child h2 { margin-top: 0; }
    .lesson-sidebar h3 {
        font-family: var(--body);
        font-size: 13px;
        font-weight: 600;
        color: var(--ink);
        margin: var(--space-3) 0 var(--space-1);
    }
    .lesson-sidebar ol { margin: 0; padding: 0; list-style: none; }
    .lesson-sidebar a {
        display: grid;
        grid-template-columns: 2.2rem 1fr;
        column-gap: var(--space-2);
        padding: 4px 6px;
        text-decoration: none;
        color: var(--ink);
        border-radius: 4px;
    }
    .lesson-sidebar a:hover {
        color: var(--accent);
        background: rgba(240, 100, 73, 0.10);
    }
    .lesson-sidebar .num {
        font-family: var(--mono);
        font-size: 0.78rem;
        color: var(--ink-soft);
        line-height: 1.5;
    }
    .lesson-sidebar .lesson-link.is-current a {
        font-weight: 600;
        background: var(--surface-mute);
    }

    .lesson-main {
        min-width: 0;
        max-width: var(--measure);
        padding-bottom: var(--space-5);
    }
    .lesson-panel {
        padding: calc(var(--card-stripes-h) + var(--space-4)) var(--space-5) var(--space-5);
    }

    @media (max-width: 880px) {
        .lesson-shell {
            grid-template-columns: 1fr;
            padding: var(--space-4) var(--space-3);
        }
        .lesson-tools {
            display: flex;
        }
        .lesson-sidebar {
            display: none;
            position: static;
            max-height: none;
        }
        .lesson-sidebar.is-open { display: block; }
        .lesson-panel {
            padding: calc(var(--card-stripes-h) + var(--space-3)) var(--space-3) var(--space-3);
        }
    }

    .site-footer {
        max-width: var(--measure);
        margin: var(--space-5) auto var(--space-4);
        padding: var(--space-3) var(--space-3) var(--space-3);
        font-family: var(--body);
        font-size: 13.5px;
        color: var(--ink);
        display: flex;
        justify-content: space-between;
        gap: var(--space-3);
        flex-wrap: wrap;
        border-top: 2px solid var(--accent);
    }
    .site-footer .muted { color: var(--ink-soft); }
    .site-footer a {
        text-decoration: underline;
        text-decoration-color: var(--accent);
        color: var(--ink);
    }
    .site-footer a:hover { color: var(--accent); }

    @media (max-width: 600px) {
        .topbar { gap: var(--space-2); padding: 0 var(--space-2); }
        .nav { gap: 4px; }
        .nav a { font-size: 13px; padding: 4px 5px; }
        .version { display: none; }
    }
</style>
