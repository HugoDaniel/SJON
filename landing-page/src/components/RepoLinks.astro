---
const repo = 'https://git.hugodaniel.com/releases/sjon';
const src = `${repo}/src/branch/main`;

type Link = { href: string; label: string; gloss: string };
type Group = { heading: string; links: Link[] };

const groups: Group[] = [
  {
    heading: 'Start here',
    links: [
      {
        href: repo,
        label: 'README',
        gloss:
          'Project overview, public <abbr title="Application Programming Interface">API</abbr>, plugin model.',
      },
      {
        href: `${src}/docs/AUTHORING.md`,
        label: 'AUTHORING.md',
        gloss: 'Hands-on guide for people writing SJON by hand.',
      },
      {
        href: `${src}/docs/INTEGRATION.md`,
        label: 'INTEGRATION.md',
        gloss: 'Pick a host: Zig, Web/Node, Rust, or TypeScript.',
      },
    ],
  },
  {
    heading: 'Reference',
    links: [
      {
        href: `${src}/docs/LANGUAGE.md`,
        label: 'LANGUAGE.md',
        gloss: 'Formal grammar + diagnostic-code catalog.',
      },
      {
        href: `${src}/docs/DESIGN.md`,
        label: 'DESIGN.md',
        gloss:
          'Architecture, SoA <abbr title="Abstract Syntax Tree">AST</abbr>, binary wire format.',
      },
      {
        href: `${src}/docs/portable-manifest-v1.md`,
        label: 'portable-manifest-v1.md',
        gloss: 'The portable plugin-manifest spec.',
      },
      {
        href: `${src}/CHANGELOG.md`,
        label: 'CHANGELOG',
        gloss: 'Versioned diary of every breaking and additive change.',
      },
    ],
  },
  {
    heading: 'Source',
    links: [
      {
        href: repo,
        label: 'Source repository',
        gloss: 'Core implementation, host wrappers, examples, and tests.',
      },
    ],
  },
];
---

<div class="repo card card--main">
    <div class="card__deck">
        <div class="repo-groups">
            {groups.map((g) => (
                <section class="repo-group" aria-label={g.heading}>
                    <h3 class="repo-group__heading">{g.heading}</h3>
                    <ul class="repo-list">
                        {g.links.map((l) => (
                            <li>
                                <a href={l.href}>
                                    <span class="label">{l.label}</span>
                                    <span class="gloss" set:html={l.gloss}></span>
                                    <span class="chev" aria-hidden="true">&rsaquo;</span>
                                </a>
                            </li>
                        ))}
                    </ul>
                </section>
            ))}
        </div>
    </div>
</div>

<style>
    .repo { margin: var(--space-3) 0; }
    .repo-groups {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        padding: calc(var(--card-stripes-h) + var(--space-3)) 0 var(--space-2);
    }
    .repo-group__heading {
        font-family: var(--display);
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--accent);
        margin: 0 18px var(--space-1);
        font-weight: 600;
    }
    .repo-list {
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .repo-list li + li { border-top: 1px solid var(--rule-mute); }
    .repo-group + .repo-group .repo-group__heading {
        border-top: 1px solid var(--rule-mute);
        padding-top: var(--space-2);
    }
    .repo-list a {
        position: relative;
        display: grid;
        grid-template-columns: 16rem 1fr auto;
        gap: var(--space-3);
        padding: 11px 18px;
        text-decoration: none;
        align-items: baseline;
        color: var(--ink);
        background: var(--surface);
        transition: background 0.12s ease, padding-left 0.12s ease;
    }
    .repo-list a::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 0;
        background: var(--accent-cool);
        transition: width 0.15s ease;
    }
    .repo-list a:hover {
        background: var(--surface-mute);
        padding-left: 22px;
    }
    .repo-list a:hover::before { width: 4px; }
    .repo-list a:hover .label { color: var(--accent); }
    .repo-list a:hover .chev  { color: var(--accent); transform: translateX(3px); }

    .repo-list .label {
        font-family: var(--mono);
        font-size: 14.5px;
        font-weight: 500;
        color: var(--ink);
        transition: color 0.12s ease;
    }
    .repo-list .gloss {
        font-family: var(--body);
        color: var(--ink-soft);
        font-size: 13.5px;
        line-height: 1.45;
    }
    .repo-list .chev {
        font-family: var(--display);
        font-size: 18px;
        color: var(--ink-soft);
        line-height: 1;
        transition: color 0.12s ease, transform 0.12s ease;
        align-self: center;
    }

    @media (max-width: 600px) {
        .repo-list a {
            grid-template-columns: 1fr auto;
            row-gap: var(--space-1);
            padding: 12px 16px;
        }
        .repo-list .label { grid-column: 1 / -2; }
        .repo-list .gloss { grid-column: 1 / -1; }
        .repo-list .chev  { grid-row: 1; grid-column: 2; align-self: start; }
    }
</style>
