---
// The fifteen-lesson tutorial table of contents.
//
// Driven by src/lib/lessons.ts, the same array that builds the sidebar and the
// loader's collection ids, so the order, titles, glosses and routes cannot
// drift from the pages they point at.
import { LESSONS } from '../lib/lessons.ts';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<ol class="lesson-outline">
    {LESSONS.map((lesson) => (
        <li>
            <a href={`${base}${lesson.route}`}>
                <span class="num">{String(lesson.num).padStart(2, '0')}</span>
                <span class="text">
                    <span class="title">{lesson.title}</span>
                    <span class="gloss">{lesson.gloss}</span>
                </span>
            </a>
        </li>
    ))}
</ol>

<style>
    .lesson-outline {
        margin: 1.5rem 0;
        padding: 0;
        list-style: none;
        border: 1px solid var(--sl-color-hairline-light);
        border-radius: 0.5rem;
        overflow: hidden;
    }
    .lesson-outline li + li {
        border-top: 1px solid var(--sl-color-hairline-light);
    }
    .lesson-outline a {
        display: grid;
        grid-template-columns: 2.5rem 1fr;
        gap: 0.75rem;
        padding: 0.7rem 1rem;
        text-decoration: none;
        color: var(--sl-color-white);
    }
    .lesson-outline a:hover {
        background: var(--sl-color-bg-nav);
        color: var(--sl-color-text-accent);
    }
    .num {
        font-family: var(--__sl-font-mono);
        font-size: var(--sl-text-sm);
        color: var(--sl-color-gray-3);
    }
    .text {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }
    .title {
        font-weight: 600;
        line-height: 1.3;
    }
    .gloss {
        color: var(--sl-color-gray-3);
        font-size: var(--sl-text-sm);
        line-height: 1.45;
    }
</style>
