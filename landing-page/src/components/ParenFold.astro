---
// Animated hero snippet. The full (scene …) form fades in one paren
// pair at a time, then "folds" the inner forms behind a ‹…› ellipsis
// on loop end. Pure CSS keyframes — no JS — apart from a single
// IntersectionObserver to trigger the run on first scroll into view.
//
// Honors prefers-reduced-motion: the snippet appears in its final
// (folded) state with no transition.
---

<figure class="parenfold card" aria-label="Animated SJON snippet showing a (scene ...) form folding into its outline.">
    <div class="card__deck">
        <div class="card__panel pf-panel">
            <p class="card__filename">examples/basic.sjon</p>
            <pre><code id="pf-code"
><span class="layer expanded"
>(scene :bpm 130
  (camera :zoom (* 2 (b 1)))
  (shape :delay 4b
    :alpha (clamp t 0 1)))</span><span
                class="layer folded" aria-hidden="true"
>(scene :bpm 130 <span class="ell">...</span>)</span></code></pre>
        </div>
    </div>
</figure>

<script is:inline>
    (function () {
        const fig = document.querySelector('.parenfold');
        if (!fig) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
            fig.classList.add('done');
            return;
        }
        const io = new IntersectionObserver((entries) => {
            for (const e of entries) {
                if (e.isIntersecting) {
                    fig.classList.add('run');
                    io.disconnect();
                }
            }
        }, { threshold: 0.4 });
        io.observe(fig);
    })();
</script>

<style>
    .parenfold {
        margin: var(--space-3) 0 var(--space-2);
    }
    .pf-panel {
        padding: var(--space-3) 0 0;
        background: transparent;
    }
    .parenfold .card__filename {
        padding: 0 var(--space-4);
    }
    .parenfold pre {
        margin: var(--space-2) 0 0;
        background: var(--surface-mute);
        padding: 12px var(--space-4);
        overflow-x: auto;
        font-size: 14px;
        font-family: var(--mono);
        font-weight: 500;
        font-variant-ligatures: none;
        line-height: 1.5;
        white-space: pre;
        position: relative;
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
        border-top: 1px solid var(--rule-mute);
    }
    .parenfold code {
        position: relative;
        display: block;
    }
    .layer {
        display: block;
        transition: opacity 0.6s ease;
    }
    .layer.folded {
        position: absolute;
        inset: 12px var(--space-4);
        opacity: 0;
        pointer-events: none;
    }
    .layer.folded .ell { color: var(--accent); }

    .parenfold.run .layer.expanded {
        animation: pf-out 1.0s ease 3.5s forwards;
    }
    .parenfold.run .layer.folded {
        animation: pf-in 1.0s ease 3.5s forwards;
    }

    @keyframes pf-out { from { opacity: 1; } to { opacity: 0; } }
    @keyframes pf-in  { from { opacity: 0; } to { opacity: 1; } }

    .parenfold.done .layer.folded { display: none; }
</style>
