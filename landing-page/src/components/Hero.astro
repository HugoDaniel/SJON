---
// Landing hero. Wordmark + tagline + selectable examples that show
// the language surface directly.
//
// Visual: a soft "card" floating on warm paper. The header is a tiny
// titlebar with three coloured pips and the file label; the body is

import ExampleCarousel from './ExampleCarousel.astro';
import { path } from '../lib/url';
import { FIRST_LESSON } from '../lib/lessons';
---

<section class="hero">
    <article class="card card--main hero-card" aria-labelledby="hero-title">
        <div class="card__deck">
            <div class="card__panel hero-panel">
                <div class="hero-intro">
                    <div class="hero-intro__text">
                        <p class="eyebrow">for domain tools</p>
                        <h1 id="hero-title" class="display">
                            SJON is the <abbr title="Domain-Specific Language">DSL</abbr> you don&rsquo;t have to write.
                        </h1>
                        <p class="tagline">
                            Most domain tools eventually grow their own little
                            config language. SJON saves you that work: a small
                            embeddable data language with schemas, helpful
                            diagnostics, units, comments, and clean
                            <abbr title="JavaScript Object Notation">JSON</abbr> interop, ready to drop in.
                            And it reads the same to the person reviewing the
                            file as to the model that wrote it.
                        </p>
                    </div>
                    <img
                        class="hero-mark"
                        src={path('/favicon.svg')}
                        alt=""
                        aria-hidden="true"
                        width="160"
                        height="160"
                    />
                </div>
                <ul class="status-list" aria-label="Project status">
                    <li>1.0</li>
                    <li><abbr title="Creative Commons Zero">CC0</abbr></li>
                    <li>Zig</li>
                    <li><abbr title="JavaScript">JS</abbr></li>
                    <li>Rust</li>
                </ul>

                <ExampleCarousel />

                <p class="cta">
                    <a class="cta-link" href={path(FIRST_LESSON.route)}>
                        <span class="cta-label">Take the tutorial</span>
                        <span class="cta-arrow" aria-hidden="true">&rarr;</span>
                    </a>
                    <a class="cta-link cta-link--secondary" href={path('/playground')}>
                        <span class="cta-label">Try it in your browser</span>
                        <span class="cta-arrow" aria-hidden="true">&rarr;</span>
                    </a>
                </p>
            </div>
        </div>
    </article>
</section>

<style>
    .hero {
        padding: var(--space-3) var(--space-3) var(--space-4);
    }
    .hero-card {
        max-width: var(--landing-width);
        margin: 0 auto;
    }
    .hero-panel {
        padding: calc(var(--card-stripes-h) + var(--space-3)) var(--landing-inset) var(--space-4);
    }
    .hero-intro {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        margin-bottom: var(--space-3);
    }
    .hero-intro__text {
        flex: 1 1 auto;
        min-width: 0;
    }
    .hero-intro__text > :last-child {
        margin-bottom: 0;
    }
    .hero-mark {
        flex: 0 0 auto;
        width: clamp(96px, 14vw, 160px);
        height: auto;
        display: block;
    }
    .eyebrow {
        font-family: var(--display);
        font-size: 12px;
        color: var(--accent);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        margin-bottom: var(--space-3);
    }
    .display {
        font-family: var(--body);
        font-size: clamp(30px, 4vw, 40px);
        font-weight: 500;
        line-height: 1.12;
        letter-spacing: 0;
        color: var(--ink);
        margin-bottom: var(--space-2);
        max-width: 820px;
    }
    .display em {
        font-style: italic;
        font-family: 'Iowan Old Style', 'Charter', 'Georgia', serif;
        font-weight: 500;
    }
    .display u {
        text-decoration: underline;
        text-decoration-color: var(--accent);
        text-decoration-thickness: 3px;
        text-underline-offset: 4px;
    }
    .tagline {
        font-family: var(--body);
        font-size: var(--step-1);
        color: var(--ink-soft);
        max-width: var(--measure);
        margin-bottom: var(--space-2);
    }
    .status-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 0 0 var(--space-3);
        padding: 0;
        list-style: none;
    }
    .status-list li {
        font-family: var(--mono);
        font-size: 12px;
        line-height: 1;
        color: var(--ink-soft);
        background: var(--surface-mute);
        border: 1px solid var(--rule-mute);
        border-radius: var(--radius-pill);
        padding: 7px 10px;
    }
    .cta {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: var(--space-3);
    }
    .cta-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--ink);
        color: var(--surface);
        text-decoration: none;
        padding: 10px 18px;
        border-radius: var(--radius-card);
        font-family: var(--body);
        font-weight: 600;
        font-size: 15px;
        box-shadow: 3px 3px 0 var(--accent);
        transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.12s ease;
    }
    .cta-link--secondary {
        background: var(--surface);
        color: var(--ink);
        border: 1px solid var(--ink);
        box-shadow: 3px 3px 0 var(--shadow);
    }
    .cta-link:hover {
        background: var(--accent);
        color: var(--surface);
        box-shadow: 3px 3px 0 var(--ink);
        transform: translate(-1px, -1px);
    }
    .cta-arrow { transition: transform 0.15s ease; }
    .cta-link:hover .cta-arrow { transform: translateX(2px); }

    @media (max-width: 600px) {
        .hero {
            padding: var(--space-2) var(--space-3) var(--space-3);
        }
        .hero-panel {
            padding: calc(var(--card-stripes-h) + var(--space-3)) var(--landing-inset) var(--space-3);
        }
        .hero-intro {
            flex-direction: column;
            align-items: flex-start;
            gap: var(--space-2);
        }
        .hero-mark {
            width: 80px;
            order: -1;
        }
        .display {
            font-size: 28px;
            line-height: 1.06;
        }
        .tagline {
            font-size: 16.5px;
            line-height: 1.48;
        }
        .cta {
            gap: 8px;
        }
        .cta-link {
            font-size: 14px;
            padding: 9px 13px;
        }
    }
</style>
