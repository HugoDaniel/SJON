---
const examples = [
  {
    id: 'zig',
    label: 'Zig',
    code: `const sjon = @import("sjon");

var tree = try sjon.parse(gpa, source);
defer tree.deinit();

const text = try sjon.print(gpa, tree, .{ .mode = .canonical });
defer text.deinit();`,
  },
  {
    id: 'js',
    label: 'JS',
    code: `import { SjonEncoder } from "./hosts/web/sjon-reader.mjs";

const sjon = await SjonEncoder.load("./zig-out/bin/sjon.wasm");
const source = '(scene :bpm 130 (canvas :name "main"))';

const report = sjon.validate(source);
const json = sjon.toJson(source, { mode: "compact" });`,
  },
  {
    id: 'rust',
    label: 'Rust',
    code: `use sjon_host::{HostOptions, SjonHost};

let mut host = SjonHost::load("./zig-out/bin/sjon.wasm", None)?;
let source = r#"(scene :bpm 130 (canvas :name "main"))"#;

let result = host.validate_document(
    source,
    &HostOptions::default(),
)?;`,
  },
];
---

<figure class="host-start" aria-labelledby="host-start-caption">
    <figcaption id="host-start-caption" class="sr-only">
        Host-language starter snippets for Zig, JavaScript, and Rust.
    </figcaption>
    <p class="host-start__note">
        Pick the host that fits your stack. The source text is the same
        either way. Just choose where you want to load it from.
    </p>
    <div class="host-start__tabs" role="tablist" aria-label="Host language">
        {examples.map((example, index) => (
            <button
                class="host-start__tab"
                type="button"
                role="tab"
                id={`host-start-tab-${example.id}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`host-start-panel-${example.id}`}
                tabindex={index === 0 ? '0' : '-1'}
                data-host-tab={example.id}
            >
                {example.label}
            </button>
        ))}
    </div>

    {examples.map((example, index) => (
        <pre
            id={`host-start-panel-${example.id}`}
            class="host-start__panel"
            role="tabpanel"
            aria-labelledby={`host-start-tab-${example.id}`}
            data-host-panel={example.id}
            hidden={index !== 0}
        ><code>{example.code}</code></pre>
    ))}
</figure>

<script is:inline>
    document.querySelectorAll('.host-start').forEach((tabsRoot) => {
        const tabs = Array.from(tabsRoot.querySelectorAll('[data-host-tab]'));
        const panels = Array.from(tabsRoot.querySelectorAll('[data-host-panel]'));

        function activate(id) {
            tabs.forEach((tab) => {
                const selected = tab.dataset.hostTab === id;
                tab.setAttribute('aria-selected', selected ? 'true' : 'false');
                tab.tabIndex = selected ? 0 : -1;
            });

            panels.forEach((panel) => {
                panel.hidden = panel.dataset.hostPanel !== id;
            });
        }

        tabs.forEach((tab, index) => {
            tab.addEventListener('click', () => activate(tab.dataset.hostTab));
            tab.addEventListener('keydown', (event) => {
                let nextIndex = index;
                if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
                else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
                else if (event.key === 'Home') nextIndex = 0;
                else if (event.key === 'End') nextIndex = tabs.length - 1;
                else return;

                event.preventDefault();
                const next = tabs[nextIndex];
                next.focus();
                activate(next.dataset.hostTab);
            });
        });
    });
</script>

<style>
    .host-start {
        margin: 0 0 var(--space-3);
        border: 1px solid var(--ink);
        border-radius: var(--radius-card);
        background: var(--surface-mute);
        overflow: hidden;
    }
    .host-start__note {
        margin: 0;
        padding: 11px var(--space-4);
        border-bottom: 1px solid var(--rule-mute);
        background: var(--surface);
        color: var(--ink-soft);
        font-family: var(--body);
        font-size: 14.5px;
        line-height: 1.5;
    }
    .host-start__tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        padding: 10px var(--space-4);
        background: var(--surface);
        border-bottom: 1px solid var(--rule-mute);
    }
    .host-start__tab {
        appearance: none;
        border: 1px solid var(--rule-mute);
        border-radius: 5px;
        background: var(--surface-mute);
        color: var(--ink);
        cursor: pointer;
        font: 600 13px/1 var(--body);
        padding: 7px 10px;
        transition: background 0.12s ease, border-color 0.12s ease, color 0.12s ease;
    }
    .host-start__tab:hover,
    .host-start__tab:focus-visible {
        border-color: var(--accent);
        outline: none;
    }
    .host-start__tab[aria-selected="true"] {
        background: var(--ink);
        border-color: var(--ink);
        color: var(--surface);
    }
    .host-start__panel {
        min-height: 210px;
        margin: 0;
        padding: var(--space-3) var(--space-4);
        overflow-x: auto;
        white-space: pre;
        color: var(--ink);
        font-family: var(--mono);
        font-size: 14.5px;
        font-weight: 500;
        font-variant-ligatures: none;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
    }
    .host-start__panel[hidden] {
        display: none;
    }

    @media (max-width: 600px) {
        .host-start__note {
            padding: 10px var(--space-3);
            font-size: 14px;
        }
        .host-start__tabs {
            padding: 10px var(--space-3);
        }
        .host-start__panel {
            min-height: 260px;
            font-size: 13.5px;
            padding: var(--space-3);
        }
    }
</style>
